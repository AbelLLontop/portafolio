#!/bin/sh
# Valida que el mensaje de commit siga la convencion documentada en CLAUDE.md
# ("Convencion de commits"). Instalado via core.hooksPath (ver scripts/install-hooks.js).

msg_file="$1"
source="$2"

msg="$(cat "$msg_file")"
subject="$(printf '%s\n' "$msg" | sed -n '1p')"

EXAMPLE='fix(blog): corrige el indice de posts huerfano tras la paginacion'

reject() {
  reason="$1"
  echo "" >&2
  echo "✗ Commit rechazado: no sigue la convencion de CLAUDE.md" >&2
  echo "" >&2
  echo "Mensaje recibido:" >&2
  echo "  $subject" >&2
  echo "" >&2
  echo "Motivo: $reason" >&2
  echo "" >&2
  echo "Ejemplo correcto:" >&2
  echo "  $EXAMPLE" >&2
  echo "" >&2
  exit 1
}

# Permite merge commits (git los marca con source=merge) y reverts automaticos
# (git revert genera el asunto 'Revert "..."' sin pasar por esta convencion).
if [ "$source" = "merge" ]; then
  exit 0
fi
case "$subject" in
  "Merge "*) exit 0 ;;
  'Revert "'*) exit 0 ;;
esac

TYPES="feat|fix|perf|refactor|style|docs|test|build|ci|chore|revert"
SCOPES="hero|terminal|about|projects|contact|navbar|seo|i18n|layout|pages|components|content|blog|lib|styles|deps|config|tests|claude|ci|git"

# Formato con ambito: tipo(ambito): descripcion
# Formato sin ambito (solo valido si el commit no es de tooling del repo): tipo: descripcion
if printf '%s' "$subject" | grep -qE "^[a-zA-Z]+\([^)]*\): .+\$"; then
  type="$(printf '%s' "$subject" | sed -nE 's/^([a-zA-Z]+)\(([^)]*)\): (.*)$/\1/p')"
  scope="$(printf '%s' "$subject" | sed -nE 's/^([a-zA-Z]+)\(([^)]*)\): (.*)$/\2/p')"
  desc="$(printf '%s' "$subject" | sed -nE 's/^([a-zA-Z]+)\(([^)]*)\): (.*)$/\3/p')"
elif printf '%s' "$subject" | grep -qE "^[a-zA-Z]+: .+\$"; then
  type="$(printf '%s' "$subject" | sed -nE 's/^([a-zA-Z]+): (.*)$/\1/p')"
  scope=""
  desc="$(printf '%s' "$subject" | sed -nE 's/^([a-zA-Z]+): (.*)$/\2/p')"
else
  reject "el asunto no sigue el formato 'tipo(ambito): descripcion' ni 'tipo: descripcion'."
fi

if ! printf '%s' "$type" | grep -qE "^($TYPES)\$"; then
  reject "el tipo '$type' no es valido. Tipos permitidos: feat, fix, perf, refactor, style, docs, test, build, ci, chore, revert."
fi

if [ -n "$scope" ] && ! printf '%s' "$scope" | grep -qE "^($SCOPES)\$"; then
  reject "el ambito '$scope' no es valido. Ambitos permitidos: hero, terminal, about, projects, contact, navbar, seo, i18n, layout, pages, components, content, blog, lib, styles, deps, config, tests, claude, ci, git."
fi

# Un commit que toca tooling del repo (.claude/, .github/, .githooks/, configs de build/lint,
# package.json/lockfile) siempre debe llevar ambito; nunca un 'chore:'/'ci:'/'build:' pelado.
if [ -z "$scope" ]; then
  tooling_files="$(git diff --cached --name-only | grep -E '^(\.claude/|\.github/|\.githooks/|package\.json$|package-lock\.json$|astro\.config\.|tailwind\.config\.|tsconfig\.json$|eslint\.config\.|playwright\.config\.)' || true)"
  if [ -n "$tooling_files" ]; then
    reject "el commit toca tooling del repo ($(printf '%s' "$tooling_files" | tr '\n' ' ')) y por eso debe llevar ambito, ej. chore(claude): ... / chore(git): ... / ci(ci): ..."
  fi
fi

subject_len=$(printf '%s' "$subject" | wc -m | tr -d ' ')
if [ "$subject_len" -gt 72 ]; then
  reject "el asunto tiene $subject_len caracteres, el maximo es 72."
fi

first_char="$(printf '%s' "$desc" | cut -c1)"
if printf '%s' "$first_char" | grep -qE '^[A-Z]$'; then
  reject "la descripcion empieza en mayuscula ('$first_char'); debe empezar en minuscula."
fi

case "$subject" in
  *.) reject "el asunto termina en punto; quitalo." ;;
esac

if printf '%s\n' "$msg" | grep -qiE '^co-authored-by:'; then
  reject "el mensaje tiene una linea Co-Authored-By; esta prohibida (ver CLAUDE.md)."
fi

# Advertencia (no bloqueante): muchos archivos sin cuerpo que explique el porque.
num_files=$(git diff --cached --name-only | wc -l | tr -d ' ')
body_lines=$(printf '%s\n' "$msg" | grep -v '^#' | sed '/^[[:space:]]*$/d' | wc -l | tr -d ' ')
if [ "$num_files" -gt 8 ] && [ "$body_lines" -le 1 ]; then
  echo "" >&2
  echo "⚠ Aviso: el commit toca $num_files archivos y no lleva cuerpo." >&2
  echo "  Si hay intenciones distintas mezcladas, considera separarlo o explicar el por que." >&2
  echo "" >&2
fi

exit 0
