---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutBody from "../../components/pages/AboutBody.astro";
import { pageTitle } from "../../lib/seo.ts";
import { useTranslations } from "../../i18n/index.ts";

const lang = "en" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={pageTitle(t("seo.about.title"))}
  description={t("seo.about.description")}
  lang={lang}
  route="about"
>
  <AboutBody lang={lang} />
</BaseLayout>
