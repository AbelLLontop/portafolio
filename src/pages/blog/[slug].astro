---
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getPostNumbers } from "../../lib/posts.ts";

export async function getStaticPaths() {
  // Sin filtro: los drafts también generan página (no salen en el listado,
  // pero se pueden ver con la URL directa). La numeración, en cambio, solo
  // cuenta las publicadas, así que un draft puede no tener número.
  const posts = await getCollection("blog");
  const numbers = await getPostNumbers();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, number: numbers.get(post.id) ?? 0 },
  }));
}

const { post, number } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
---

<BlogPostLayout post={post} number={number} headings={tocHeadings} lang="es">
  <Content />
</BlogPostLayout>
