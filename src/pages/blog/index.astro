---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList, {
  type BlogListPost,
} from "../../components/react/BlogList";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const chronological = [...posts].sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const numbers = new Map(
  chronological.map((post, index) => [post.id, index + 1]),
);

const listPosts: BlogListPost[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  summary: post.data.summary,
  tags: post.data.tags,
  number: numbers.get(post.id) ?? 0,
  formattedDate: post.data.date.toLocaleDateString("es-PE", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }),
}));
---

<BaseLayout
  title="Blog — abelitolll"
  description="Artículos y notas técnicas de abelitolll."
>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="flex items-center gap-3">
      <img
        src="/images/abelitolll-head.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0"
      />
      <h1 class="text-3xl font-bold text-zinc-100">Blog</h1>
    </div>
    {listPosts.length === 0 ? (
      <div class="mt-8 rounded-lg border border-dashed border-zinc-800 p-8 text-center">
        <p class="text-zinc-300">Todavía no hay notas publicadas.</p>
        <p class="mt-2 text-sm text-zinc-400">
          Estoy escribiendo las primeras — vuelve pronto.
        </p>
      </div>
    ) : (
      <div class="mt-8">
        <BlogList posts={listPosts} client:visible />
      </div>
    )}
  </main>
</BaseLayout>
