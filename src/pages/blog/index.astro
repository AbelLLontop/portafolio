---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList, {
  type BlogListPost,
} from "../../components/react/BlogList";
import ScrollReveal from "../../components/react/ScrollReveal.tsx";
import { formatPostDate } from "../../lib/dates.ts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const chronological = [...posts].sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
);
const numbers = new Map(
  chronological.map((post, index) => [post.id, index + 1]),
);

const listPosts: BlogListPost[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  summary: post.data.summary,
  tags: post.data.tags,
  number: numbers.get(post.id) ?? 0,
  formattedDate: formatPostDate(post.data.date),
}));
---

<BaseLayout
  title="Blog — abelitolll"
  description="Artículos y notas técnicas de abelitolll."
>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <ScrollReveal client:visible>
      <p class="section-label">Notas técnicas</p>
      <div class="mt-3 flex items-center gap-3">
        <img
          src="/images/abelitolll-head.svg"
          alt=""
          width="40"
          height="40"
          class="h-9 w-9 shrink-0"
        />
        <h1 class="font-display text-4xl font-bold tracking-[-0.02em] text-zinc-100 md:text-5xl">
          Blog
        </h1>
      </div>
      <p class="mt-3 max-w-[52ch] leading-relaxed" style="color: var(--dim);">
        Acá anoto lo que voy aprendiendo mientras programo, más que nada para no olvidarlo
        después.
      </p>
    </ScrollReveal>
    {listPosts.length === 0 ? (
      <ScrollReveal client:visible delay={0.05} className="mt-8 rounded-xl border border-dashed border-[var(--line)] p-8 text-center">
        <p class="text-zinc-300">Todavía no hay notas publicadas.</p>
        <p class="mt-2 text-sm text-zinc-400">
          Estoy escribiendo las primeras — vuelve pronto.
        </p>
      </ScrollReveal>
    ) : (
      <ScrollReveal client:visible delay={0.05} className="mt-8">
        <BlogList posts={listPosts} client:visible />
      </ScrollReveal>
    )}
  </main>
</BaseLayout>
