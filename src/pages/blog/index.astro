---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostCard from "../../components/astro/BlogPostCard.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="Blog — abelitolll"
  description="Artículos y notas técnicas de abelitolll."
>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex items-center gap-3">
      <img
        src="/images/abelitolll-head.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0"
      />
      <h1 class="text-3xl font-bold text-zinc-100">Blog</h1>
    </div>
    {posts.length === 0 ? (
      <div class="mt-8 rounded-lg border border-dashed border-zinc-800 p-8 text-center">
        <p class="text-zinc-300">Todavía no hay notas publicadas.</p>
        <p class="mt-2 text-sm text-zinc-400">
          Estoy escribiendo las primeras — vuelve pronto.
        </p>
      </div>
    ) : (
      <div class="mt-8 flex flex-col divide-y divide-zinc-800">
        {posts.map((post) => (
          <div class="py-6 first:pt-0">
            <BlogPostCard post={post} />
          </div>
        ))}
      </div>
    )}
  </main>
</BaseLayout>
