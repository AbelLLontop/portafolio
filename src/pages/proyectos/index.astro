---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectsIndexBody from "../../components/pages/ProjectsIndexBody.astro";
import { pageTitle } from "../../lib/seo.ts";
import { useTranslations } from "../../i18n/index.ts";

const lang = "es" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={pageTitle(t("seo.projects.title"))}
  description={t("seo.projects.description")}
  lang={lang}
  route="projects"
>
  <ProjectsIndexBody lang={lang} />
</BaseLayout>
