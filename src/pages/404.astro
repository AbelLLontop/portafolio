---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFoundBody from "../components/pages/NotFoundBody.astro";
import { pageTitle } from "../lib/seo.ts";
import { useTranslations } from "../i18n/index.ts";

// Un solo 404 para todo el sitio (Vercel sirve /404.html para cualquier ruta
// inexistente). Se construye en español; NotFoundBody cambia al inglés en el
// cliente cuando la URL empieza por /en/.
const lang = "es" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={pageTitle(t("seo.notFound.title"))}
  description={t("seo.notFound.description")}
  lang={lang}
  route="notFound"
  noindex
>
  <NotFoundBody />
</BaseLayout>
