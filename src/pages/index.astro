---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/astro/Hero.astro";
import TechMarquee from "../components/astro/TechMarquee.astro";
import ProjectsSection from "../components/astro/ProjectsSection.astro";
import ContactSection from "../components/astro/ContactSection.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
---

<BaseLayout
  title="abelitolll — Desarrollador de software"
  description="abelitolll — desarrollador de software peruano. Notas técnicas, proyectos y experimentos, con apoyo de herramientas de IA."
>
  <ScrollReveal client:visible>
    <Hero />
  </ScrollReveal>
  <ScrollReveal client:visible delay={0.05}>
    <TechMarquee />
  </ScrollReveal>
  <ScrollReveal client:visible delay={0.1}>
    <ProjectsSection />
  </ScrollReveal>
  <ScrollReveal client:visible delay={0.15}>
    <ContactSection />
  </ScrollReveal>
</BaseLayout>
