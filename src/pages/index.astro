---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/astro/Hero.astro";
import TechMarquee from "../components/astro/TechMarquee.astro";
import ProjectsSection from "../components/astro/ProjectsSection.astro";
import ContactSection from "../components/astro/ContactSection.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
---

<BaseLayout
  title="abelitolll — Desarrollador de software"
  description="abelitolll — página personal de Abel Llontop, desarrollador de software peruano. Backend, aplicaciones web y notas técnicas."
>
  <Hero />
  <ScrollReveal client:visible y={16}>
    <TechMarquee />
  </ScrollReveal>
  <ScrollReveal client:visible y={32}>
    <ProjectsSection />
  </ScrollReveal>
  <ScrollReveal client:visible y={32}>
    <ContactSection />
  </ScrollReveal>
</BaseLayout>
