---
import BaseLayout from "../layouts/BaseLayout.astro";
import RadioBody from "../components/pages/RadioBody.astro";
import { pageTitle } from "../lib/seo.ts";
import { useTranslations } from "../i18n/index.ts";

const lang = "es" as const;
const t = useTranslations(lang);
---

<BaseLayout
  title={pageTitle(t("seo.radio.title"))}
  description={t("seo.radio.description")}
  lang={lang}
>
  <RadioBody lang={lang} />
</BaseLayout>
