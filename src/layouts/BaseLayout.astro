---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Starfield from "../components/react/decor/Starfield.tsx";
import CursorRocket from "../components/react/decor/CursorRocket.tsx";
import AscentHud from "../components/astro/AscentHud.astro";
import { buildSeoMeta, SITE_LOCALES, SITE_NAME } from "../lib/seo.ts";
import { otherLang, type Lang } from "../i18n/index.ts";
import type { Route } from "../i18n/routes.ts";
import { INSTANT_NAV_CLASS, INSTANT_NAV_KEY } from "../lib/instant-nav.ts";

interface Props {
  title: string;
  lang: Lang;
  /** Qué página es, para armar el botón ES/EN y los hreflang. */
  route: Route;
  /** Solo para `route="post"`. */
  slug?: string;
  description?: string;
  image?: string;
}

const { title, lang, route, slug, description, image } = Astro.props;
const seo = buildSeoMeta({ title, url: Astro.url, lang, route, slug, description, image });
---

<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira:wght@600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Tiene que ser inline y acá arriba: corre antes del primer pintado, así
        que al cambiar de idioma la página ya aparece en su estado final en
        vez de revelarse de nuevo. Un script empaquetado llegaría tarde. */}
    <script is:inline define:vars={{ key: INSTANT_NAV_KEY, cls: INSTANT_NAV_CLASS }}>
      try {
        if (sessionStorage.getItem(key) === "1") {
          sessionStorage.removeItem(key);
          document.documentElement.classList.add(cls);
        }
      } catch {
        // Sin sessionStorage simplemente se anima como en cualquier carga.
      }
    </script>

    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.url} />

    {/* Cada idioma declara al otro, y x-default manda al español (el sitio
        por defecto) cuando el navegador no matchea ninguno. */}
    {seo.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={seo.defaultHref} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:locale:alternate" content={SITE_LOCALES[otherLang(lang)]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:url" content={seo.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
  </head>
  <body class="flex min-h-screen flex-col">
    <div class="veil"></div>
    <Starfield client:visible />
    <CursorRocket client:visible />
    {route === "post" && <AscentHud lang={lang} />}
    <Header lang={lang} route={route} slug={slug} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer lang={lang} />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
