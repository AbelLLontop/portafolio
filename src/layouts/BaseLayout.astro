---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Library from "../components/layout/Library.astro";
import Player from "../components/react/radio/Player.tsx";
import { buildSeoMeta, serializeJsonLd, SITE_NAME } from "../lib/seo.ts";
import { getRadioTracks } from "../lib/radio.ts";
import { pickStrings, useTranslations, type Lang } from "../i18n/index.ts";
import { pathFor } from "../i18n/routes.ts";

interface Props {
  title: string;
  lang: Lang;
  /** El id del perfil abierto, para marcarlo en la biblioteca. */
  current?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageSize?: { width: number; height: number };
  imageType?: string;
  /** `article` en los perfiles. */
  ogType?: "website" | "article";
  /** Datos estructurados (schema.org) que la página quiere declarar. */
  jsonLd?: Record<string, unknown>;
  /** Páginas que no deben indexarse ni declarar canonical (el 404). */
  noindex?: boolean;
}

const {
  title,
  lang,
  current,
  description,
  image,
  imageAlt,
  imageSize,
  imageType,
  ogType,
  jsonLd,
  noindex,
} = Astro.props;
const t = useTranslations(lang);
const tracks = await getRadioTracks();
const playerStrings = pickStrings(lang, [
  "player.play",
  "player.pause",
  "player.prev",
  "player.next",
  "player.lyrics",
  "player.list",
  "player.back",
  "player.mute",
  "player.unmute",
  "player.volume",
  "player.seek",
  "player.intro",
  "player.noLyrics",
  "player.spotify",
]);
const seo = buildSeoMeta({
  title,
  url: Astro.url,
  lang,
  description,
  image,
  imageAlt,
  imageSize,
  imageType,
  type: ogType,
});
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Color de la barra del navegador en móvil: el sitio tiene un solo tema. */}
    <meta name="theme-color" content="#0c0c0e" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Navegación sin recargar el documento: Astro intercepta los enlaces
        internos, se trae el HTML y reemplaza el <body>. El sitio sigue siendo
        100% estático — esto es solo la capa de cliente. */}
    <ClientRouter />

    <meta name="description" content={seo.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={seo.url} />}

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    {seo.imageType && <meta property="og:image:type" content={seo.imageType} />}
    {seo.imageSize && (
      <>
        <meta property="og:image:width" content={String(seo.imageSize.width)} />
        <meta
          property="og:image:height"
          content={String(seo.imageSize.height)}
        />
      </>
    )}
    <meta property="og:url" content={seo.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={serializeJsonLd(jsonLd)}
      />
    )}
  </head>
  <body>
    <div class="app">
      <header class="mobile-top">
        <button
          type="button"
          class="mt-lib"
          data-lib-toggle
          aria-label={t("lib.open")}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <a class="mt-brand" href={pathFor("home", lang)}>
          <i aria-hidden="true"></i>abelitolll
        </a>
      </header>
      <Library lang={lang} current={current} />
      <main class="stage" id="stage">
        <slot />
      </main>
      {/* transition:persist: el reproductor no se vuelve a montar al navegar,
          así la música y la letra siguen sonando entre páginas. */}
      <div class="bar-slot" transition:persist="radio">
        <Player
          client:load
          tracks={tracks}
          strings={playerStrings}
          listPath={pathFor("radio", lang)}
        />
      </div>
    </div>
    <script>
      // Cualquier fila con data-radio-row (la lista de la radio, las canciones
      // de un experimento) le pide al reproductor que toque su pista; si ya
      // suena, la pausa. Va acá, una sola vez para todo el sitio: si cada
      // página trajera su listener, después de visitar dos se tocaría dos
      // veces y la pista se pausaría sola.
      document.addEventListener("click", (event) => {
        const row = (event.target as Element).closest<HTMLButtonElement>(
          "[data-radio-row]",
        );
        if (!row || row.disabled || !row.dataset.trackId) return;
        window.dispatchEvent(
          new CustomEvent("radio:play", {
            detail: { id: row.dataset.trackId },
          }),
        );
      });
    </script>
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
