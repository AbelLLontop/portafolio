---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingParticles from "../components/react/decor/FloatingParticles.tsx";
import CursorRocket from "../components/react/decor/CursorRocket.tsx";
import { buildSeoMeta, SITE_LOCALE, SITE_NAME } from "../lib/seo.ts";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const seo = buildSeoMeta({ title, url: Astro.url, description, image });
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.url} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:url" content={seo.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
  </head>
  <body class="flex min-h-screen flex-col">
    <FloatingParticles client:visible />
    <CursorRocket client:visible />
    <Header />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
