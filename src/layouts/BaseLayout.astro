---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { buildSeoMeta, SITE_NAME } from "../lib/seo.ts";
import type { Lang } from "../i18n/index.ts";
import type { Route } from "../i18n/routes.ts";

interface Props {
  title: string;
  lang: Lang;
  /** Qué página es, para marcar la sección actual en la navegación. */
  route: Route;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** Páginas que no deben indexarse ni declarar canonical (el 404). */
  noindex?: boolean;
}

const { title, lang, route, description, image, imageAlt, noindex } =
  Astro.props;
const seo = buildSeoMeta({
  title,
  url: Astro.url,
  lang,
  description,
  image,
  imageAlt,
});
---

<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Saira:wght@600;700;800&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    {/* Color de la barra del navegador en móvil: el sitio tiene un solo tema. */}
    <meta name="theme-color" content="#09090b" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Navegación sin recargar el documento: Astro intercepta los enlaces
        internos, se trae el HTML y reemplaza el <body>. El sitio sigue siendo
        100% estático — esto es solo la capa de cliente. */}
    <ClientRouter />

    <meta name="description" content={seo.description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={seo.url} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:alt" content={seo.imageAlt} />
    {seo.imageSize && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(seo.imageSize.width)} />
        <meta
          property="og:image:height"
          content={String(seo.imageSize.height)}
        />
      </>
    )}
    <meta property="og:url" content={seo.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.imageAlt} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header lang={lang} route={route} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer lang={lang} />
    <script>
      import { SWAP_CLASS } from "../lib/nav-flags.ts";

      // Este módulo corre una sola vez en toda la sesión: el router reemplaza
      // el <body>, pero no vuelve a ejecutar los scripts ya cargados. Por eso
      // los listeners van sobre `document`, que sobrevive al swap.
      document.addEventListener("astro:after-swap", () => {
        // after-swap: el DOM nuevo ya está puesto y el navegador todavía no
        // pintó, así que las clases llegan a tiempo y nada se revela por un
        // frame antes de apagarse.
        const root = document.documentElement;
        root.classList.add(SWAP_CLASS);
      });
    </script>
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
