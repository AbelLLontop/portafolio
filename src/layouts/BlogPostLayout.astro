---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<"blog">;
  number: number;
}

const { post, number } = Astro.props;
const { title, date, summary } = post.data;

const formattedDate = date.toLocaleDateString("es-PE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={`${title} — abelitolll`} description={summary}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <article>
      <header class="mb-8 border-b border-zinc-800 pb-6">
        <div class="flex items-center gap-3">
          <img
            src="/images/abelitolll-head.svg"
            alt=""
            width="32"
            height="32"
            class="h-8 w-8 shrink-0"
          />
          <h1 class="text-3xl font-bold text-zinc-100">
            {title} <span class="font-mono text-accent">#{number}</span>
          </h1>
        </div>
        <p class="mt-2 text-sm text-zinc-400">{formattedDate}</p>
      </header>
      <div class="prose-post-body">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>
