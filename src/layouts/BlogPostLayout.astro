---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/astro/TableOfContents.astro";
import TechBadge from "../components/astro/TechBadge.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
import { formatPostDate } from "../lib/dates.ts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  number: number;
  headings?: Heading[];
}

const { post, number, headings = [] } = Astro.props;
const { title, date, summary, tags } = post.data;

const formattedDate = formatPostDate(date);
---

<BaseLayout title={`${title} — abelitolll`} description={summary}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="lg:grid lg:grid-cols-[1fr_12rem] lg:gap-10">
      <article class="max-w-3xl">
        <div id="post-header-sentinel"></div>
        <header class="post-header sticky top-16 z-40 mb-6 border-b border-transparent pb-6 pt-4">
          <p class="post-eyebrow section-label">Nota #{number}</p>
          <h1 class="mt-3 font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
            {title}
          </h1>
          <p class="post-date mt-2 font-mono text-xs tracking-[0.08em]" style="color: var(--faint);">
            {formattedDate}
          </p>
        </header>

        {tags.length > 0 && (
          <ul class="mb-8 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <TechBadge name={tag} />
            ))}
          </ul>
        )}

        <ScrollReveal client:visible y={0}>
          <div class="prose-post-body">
            <slot />
          </div>
        </ScrollReveal>

        <footer class="mt-14 border-t pt-6" style="border-color: var(--line);">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.08em] transition-colors hover:text-accent"
            style="color: var(--dim);"
          >
            <span aria-hidden="true">&#8592;</span> volver a las notas
          </a>
        </footer>
      </article>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <ScrollReveal client:visible y={0} delay={0.1}>
            <TableOfContents headings={headings} />
          </ScrollReveal>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* Evita que el navegador "compense" el cambio de alto del header
     reajustando el scroll (scroll anchoring), que es lo que provocaba
     el bucle de encoger/crecer al hacer scroll lento. */
  article {
    overflow-anchor: none;
  }

  .post-header,
  .post-header h1,
  .post-header .post-date,
  .post-header .post-eyebrow {
    transition:
      padding 0.2s ease,
      font-size 0.2s ease,
      width 0.2s ease,
      height 0.2s ease,
      opacity 0.15s ease,
      max-height 0.2s ease,
      margin 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .post-header.is-stuck {
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    background-color: color-mix(in srgb, var(--color-accent) 6%, #0c0c10 94%);
    border-color: var(--line);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(8px);
  }

  .post-header.is-stuck h1 {
    margin-top: 0;
    font-size: 1.125rem;
  }

  .post-header.is-stuck .post-date,
  .post-header.is-stuck .post-eyebrow {
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".post-header");
  const sentinel = document.getElementById("post-header-sentinel");

  if (header && sentinel) {
    // Umbral fijo (independiente del alto actual del header) para que
    // encoger/crecer el header no mueva el propio punto de disparo.
    const NAV_HEIGHT = 64;
    const baseline = sentinel.getBoundingClientRect().top + window.scrollY - NAV_HEIGHT;
    const HYSTERESIS = 6;

    let stuck = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      if (!stuck && window.scrollY > baseline + HYSTERESIS) {
        stuck = true;
        header.classList.add("is-stuck");
      } else if (stuck && window.scrollY < baseline - HYSTERESIS) {
        stuck = false;
        header.classList.remove("is-stuck");
      }
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>

<script>
  // Shiki ya deja el lenguaje en data-language, asi que la barra se monta
  // sobre el <pre> existente sin tocar los .mdx ni el tema.
  const blocks = document.querySelectorAll<HTMLPreElement>(".prose-post-body pre.astro-code");

  blocks.forEach((pre) => {
    const wrapper = document.createElement("figure");
    wrapper.className = "code-block";

    const bar = document.createElement("figcaption");
    bar.className = "code-block-bar";

    const language = document.createElement("span");
    language.textContent = pre.dataset.language ?? "texto";

    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy";
    button.textContent = "copiar";

    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "copiado";
        button.classList.add("is-copied");
      } catch {
        button.textContent = "no se pudo copiar";
      }
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        button.textContent = "copiar";
        button.classList.remove("is-copied");
      }, 1800);
    });

    bar.append(language, button);
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.append(bar, pre);
  });
</script>
