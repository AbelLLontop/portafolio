---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/astro/TableOfContents.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
import { formatPostDate } from "../lib/dates.ts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  number: number;
  headings?: Heading[];
}

const { post, number, headings = [] } = Astro.props;
const { title, date, summary } = post.data;

const formattedDate = formatPostDate(date);
---

<BaseLayout title={`${title} — abelitolll`} description={summary}>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="lg:grid lg:grid-cols-[1fr_12rem] lg:gap-10">
      <article class="max-w-3xl">
        <!-- Header real: estatico, es el unico que ocupa espacio en el flujo.
             No se encoge nunca, asi que el contenido de abajo no se mueve. -->
        <header class="post-header mb-6 pb-6 pt-4">
          <div class="post-eyebrow flex items-center gap-3">
            <span class="post-chip">Nota #{number}</span>
            <span class="h-px flex-1" style="background: var(--line);"></span>
          </div>
          <h1 class="post-title mt-3 font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
            {title}
          </h1>
          <p class="post-date mt-3 font-mono text-xs tracking-[0.08em]" style="color: var(--faint);">
            {formattedDate}
          </p>
        </header>

        <!-- Caja sticky de alto 0: no ocupa espacio en el flujo, pero al vivir
             dentro del <article> hereda su ancho, asi que el panel queda
             alineado con el titulo real sin calcular nada. -->
        <div class="post-bar" aria-hidden="true">
          <div class="post-bar-panel flex items-center gap-3 py-3">
            <span class="post-chip shrink-0">#{number}</span>
            <span class="truncate font-display text-base font-bold tracking-[-0.01em] text-zinc-100">
              {title}
            </span>
          </div>
        </div>

        <ScrollReveal client:visible y={0}>
          <div class="prose-post-body">
            <slot />
          </div>
        </ScrollReveal>

        <footer class="mt-14 border-t pt-6" style="border-color: var(--line);">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.08em] transition-colors hover:text-accent"
            style="color: var(--dim);"
          >
            <span aria-hidden="true">&#8592;</span> volver a las notas
          </a>
        </footer>
      </article>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <ScrollReveal client:visible y={0} delay={0.1}>
            <TableOfContents headings={headings} />
          </ScrollReveal>
        </div>
      </aside>
    </div>

  </main>
</BaseLayout>

<style>
  /* Alto 0: la caja se pega arriba pero no ocupa ni un pixel del flujo, asi
     que el contenido de abajo nunca se mueve. El header real no cambia de
     tamanio: los dos titulos se cruzan por opacidad. */
  .post-bar {
    position: sticky;
    top: 4rem; /* alto del nav */
    z-index: 40;
    height: 0;
  }

  .post-bar-panel {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid var(--line);
    background-color: color-mix(in srgb, var(--color-accent) 6%, #0c0c10 94%);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(8px);
    opacity: 0;
    /* Sin el translate la barra "aterriza" de golpe; con -0.25rem entra
       deslizandose apenas, en el mismo gesto del scroll. */
    transform: translateY(-0.25rem);
    pointer-events: none;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0.18s;
    visibility: hidden;
  }

  .post-bar.is-visible .post-bar-panel {
    opacity: 1;
    transform: none;
    visibility: visible;
  }

  /* En mobile la banda llega a los bordes como el nav: -1rem es justo el px-4
     del <main>. El padding devuelve el texto a su sitio, alineado con el
     titulo real. Arriba de 768px el panel ya coincide con la columna del post
     por si solo, sin tocar nada. */
  @media (max-width: 767px) {
    .post-bar-panel {
      margin-right: -1rem;
      margin-left: -1rem;
      padding-right: 1rem;
      padding-left: 1rem;
    }
  }

  /* El titulo grande se desvanece mientras sube: evita el instante en que se
     ve dos veces el mismo texto, uno entrando y otro saliendo. */
  .post-title {
    transition: opacity 0.18s ease;
  }

  .post-header.is-handed-off .post-title {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-bar-panel,
    .post-title {
      transition: none;
    }

    .post-bar-panel {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".post-header");
  const title = document.querySelector<HTMLElement>(".post-title");
  const bar = document.querySelector<HTMLElement>(".post-bar");

  if (header && title && bar) {
    const NAV_HEIGHT = 64;
    // Se mide el titulo real en vivo (no un umbral guardado): el relevo pasa
    // justo cuando el h1 grande termina de esconderse detras del nav.
    const HYSTERESIS = 8;

    let visible = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const bottom = title.getBoundingClientRect().bottom;

      if (!visible && bottom < NAV_HEIGHT - HYSTERESIS) {
        visible = true;
        bar.classList.add("is-visible");
        header.classList.add("is-handed-off");
      } else if (visible && bottom > NAV_HEIGHT + HYSTERESIS) {
        visible = false;
        bar.classList.remove("is-visible");
        header.classList.remove("is-handed-off");
      }
    };

    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", request, { passive: true });
  }
</script>

<script>
  const body = document.querySelector<HTMLElement>(".prose-post-body");

  if (body) {
    // ---- Bloques de codigo -------------------------------------------------
    // Shiki ya deja el lenguaje en data-language, asi que la barra se monta
    // sobre el <pre> existente sin tocar los .mdx ni el tema.
    const ICON_COPY =
      '<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M14 5.5A2.5 2.5 0 0 0 11.5 3h-6A2.5 2.5 0 0 0 3 5.5v6A2.5 2.5 0 0 0 5.5 14"/></svg>';
    const ICON_CHECK =
      '<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    body.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
      const raw = pre.dataset.language ?? "plaintext";
      const language = raw === "plaintext" ? "texto" : raw;

      const wrapper = document.createElement("figure");
      wrapper.className = "code-block";
      wrapper.dataset.lang = language;

      const chrome = document.createElement("figcaption");
      chrome.className = "code-chrome";
      chrome.innerHTML = `<span class="code-id"><i class="code-dot"></i><i class="code-dot-idle"></i><i class="code-dot-idle"></i><span class="code-lang">${language}</span></span>`;

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.dataset.tip = "Copiar";
      button.setAttribute("aria-label", `Copiar el código ${language}`);
      button.innerHTML = ICON_COPY + ICON_CHECK;

      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.state = "copied";
          button.dataset.tip = "Copiado";
        } catch {
          button.dataset.state = "error";
          button.dataset.tip = "No se pudo copiar";
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          delete button.dataset.state;
          button.dataset.tip = "Copiar";
        }, 1800);
      });

      chrome.append(button);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(pre, chrome);
    });

    // ---- Anclas de heading -------------------------------------------------
    // Reusa los ids que ya genera Astro (los mismos que consume el indice).
    body.querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]").forEach((heading) => {
      const anchor = document.createElement("a");
      anchor.className = "heading-anchor";
      anchor.href = `#${heading.id}`;
      anchor.textContent = "#";
      anchor.setAttribute("aria-label", `Enlace a la sección ${heading.textContent ?? ""}`);
      heading.prepend(anchor);
    });

    // ---- Tablas ------------------------------------------------------------
    // Sin el marco con scroll propio, una tabla ancha desborda la columna.
    body.querySelectorAll("table").forEach((table) => {
      const wrapper = document.createElement("div");
      wrapper.className = "table-wrap";
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.append(table);
    });
  }
</script>
