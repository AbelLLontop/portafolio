---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/astro/TableOfContents.astro";
import ScrollReveal from "../components/react/ScrollReveal.tsx";
import { formatPostDate } from "../lib/dates.ts";
import { pageTitle } from "../lib/seo.ts";
import { interpolate, useTranslations, type Lang } from "../i18n/index.ts";
import { pathFor } from "../i18n/routes.ts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: CollectionEntry<"blog">;
  number: number;
  lang: Lang;
  headings?: Heading[];
}

const { post, number, lang, headings = [] } = Astro.props;
const { title, date, summary } = post.data;

const t = useTranslations(lang);
const formattedDate = formatPostDate(date, lang);
---

<BaseLayout
  title={pageTitle(title)}
  description={summary}
  lang={lang}
  route="post"
  slug={post.id}
>
  <main class="mx-auto max-w-5xl px-4 py-12">
    <div class="lg:grid lg:grid-cols-[1fr_12rem] lg:gap-10">
      <article class="max-w-3xl">
        <!-- El titulo es hijo directo del <article> (alto, cubre todo el post):
             asi el sticky tiene recorrido para quedarse pegado durante todo
             el scroll, en vez de quedar acotado por un <header> chico. -->
        <div class="post-eyebrow flex items-center gap-3 pt-4">
          <span class="post-chip">
            {interpolate(t("post.chip"), { number })}
          </span>
          <span class="h-px flex-1" style="background: var(--line);"></span>
        </div>

        <div class="post-title-sentinel" aria-hidden="true"></div>
        <h1 class="post-title sticky top-16 z-40 mt-3 flex items-center font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
          <span class="post-title-number" aria-hidden="true">
            #{number}
          </span>
          {title}
        </h1>

        <p
          class="post-date mt-3 mb-6 pb-6 font-mono text-xs tracking-[0.08em]"
          style="color: var(--faint);"
        >
          {formattedDate}
          {/* Los .mdx no se traducen: leyendo en inglés conviene saberlo
              antes de empezar el post, no a mitad de camino. */}
          {lang !== "es" && (
            <>
              <span aria-hidden="true"> · </span>
              <span>{t("post.spanishNotice")}</span>
            </>
          )}
        </p>

        <ScrollReveal client:visible y={0}>
          {/* El copy del script (botón de copiar, anclas) viaja por data-*:
              un <script> de Astro se empaqueta aparte y no ve estas props,
              y `define:vars` lo volvería inline y sin tipado TS. */}
          <div
            class="prose-post-body"
            data-copy={t("post.copy")}
            data-copied={t("post.copied")}
            data-copy-error={t("post.copyError")}
            data-copy-aria={t("post.copyAria")}
            data-plaintext={t("post.plaintext")}
            data-heading-anchor={t("post.headingAnchor")}
          >
            <slot />
          </div>
        </ScrollReveal>

        <footer class="mt-14 border-t pt-6" style="border-color: var(--line);">
          <a
            href={pathFor("blog", lang)}
            class="inline-flex items-center gap-2 font-mono text-xs tracking-[0.08em] transition-colors hover:text-accent"
            style="color: var(--dim);"
          >
            <span aria-hidden="true">&#8592;</span> {t("post.back")}
          </a>
        </footer>
      </article>
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <ScrollReveal client:visible y={0} delay={0.1}>
            <TableOfContents headings={headings} lang={lang} />
          </ScrollReveal>
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  /* El titulo es el mismo elemento siempre: no hay duplicado ni crossfade.
     Al quedar pegado (JS agrega is-stuck justo cuando el sticky engancha)
     se encoge a tamanio de barra y gana un fondo propio, para no quedar
     gigante ni superponerse ilegible sobre el contenido que sigue subiendo
     detras. */
  /* Punto de referencia sin tamanio, en el mismo lugar del flujo donde
     arranca el titulo. El h1 mide siempre lo mismo mientras esta sticky
     (pegado), asi que hace falta medir OTRO elemento, que si siga
     scrolleando libremente, para saber cuando el titulo quedo pegado. */
  .post-title-sentinel {
    height: 0;
  }

  /* El borde y el blur quedan declarados siempre (transparente / 0px) para
     que tengan algo animable de donde partir: si "border-style" o el filtro
     recien aparecen en el estado final, el navegador los aplica de golpe
     sin transicion, y es justo eso lo que se sentia como un salto o rebote
     en vez de un cambio suave. */
  .post-title {
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(0px);
    transition:
      font-size 0.22s ease-out,
      padding 0.22s ease-out,
      background-color 0.22s ease-out,
      box-shadow 0.22s ease-out,
      border-color 0.22s ease-out,
      backdrop-filter 0.22s ease-out;
  }

  .post-title.is-stuck {
    padding: 0.65rem 0;
    font-size: 1.05rem;
    line-height: 1.4;
    border-bottom-color: var(--line);
    background-color: color-mix(in srgb, var(--color-accent) 6%, #0c0c10 94%);
    box-shadow: 0 4px 12px -4px rgb(0 0 0 / 0.4);
    backdrop-filter: blur(8px);
  }

  /* Numero de nota: solo tiene sentido cuando el titulo esta encogido y
     funciona como barra (el chip "Nota #N" grande ya esta arriba, visible,
     mientras el titulo es grande). Ocupa 0 de ancho hasta entonces, asi que
     aparece deslizandose en vez de empujar el texto de golpe. */
  .post-title-number {
    display: inline-block;
    overflow: hidden;
    max-width: 0;
    opacity: 0;
    margin-right: 0;
    font-size: 0.85em;
    font-weight: 700;
    color: var(--faint);
    white-space: nowrap;
    transition:
      max-width 0.22s ease-out,
      opacity 0.22s ease-out,
      margin-right 0.22s ease-out;
  }

  .post-title.is-stuck .post-title-number {
    max-width: 4rem;
    opacity: 1;
    margin-right: 0.5rem;
  }

  /* En mobile la banda llega a los bordes como el nav: -1rem es justo el
     px-4 del <main>. El padding horizontal devuelve el texto a su sitio.
     Arriba de 768px el titulo ya coincide con la columna del post por si
     solo. */
  @media (max-width: 767px) {
    .post-title.is-stuck {
      margin-right: -1rem;
      margin-left: -1rem;
      padding: 0.65rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-title,
    .post-title-number {
      transition: none;
    }
  }
</style>

<script>
  // Con el router de cliente este modulo corre una sola vez, pero el titulo y
  // el centinela son elementos nuevos en cada post: el observer se rehace en
  // cada pagina y el anterior se desconecta, porque observaria un elemento que
  // ya no esta en el documento.
  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();

    const sentinel = document.querySelector<HTMLElement>(
      ".post-title-sentinel",
    );
    const title = document.querySelector<HTMLElement>(".post-title");
    if (!sentinel || !title) return;

    const NAV_HEIGHT = 64; /* alto del nav, = top-16 del titulo */

    // El titulo mismo no sirve como referencia: una vez sticky, su posicion
    // queda fija y nunca cruza ningun umbral. El centinela, en cambio, sigue
    // scrolleando libre: cuando pasa por detras del nav es el mismo instante
    // en que el sticky frena al titulo ahi, asi que ese es el momento de
    // encogerlo.
    observer = new IntersectionObserver(
      ([entry]) => {
        title.classList.toggle("is-stuck", !entry.isIntersecting);
      },
      { rootMargin: `-${NAV_HEIGHT}px 0px 0px 0px`, threshold: 0 },
    );

    observer.observe(sentinel);
  });
</script>

<script>
  // Con el router de cliente este modulo corre una sola vez, pero el cuerpo
  // del post es markup nuevo en cada nota, asi que el realce se rehace por
  // pagina. `data-enhanced` lo marca ya hecho: el markup que llega del
  // servidor nunca lo trae, y asi un segundo `astro:page-load` sobre el mismo
  // DOM (volver atras, por ejemplo) no duplica barras ni anclas.
  document.addEventListener("astro:page-load", () => {
    const body = document.querySelector<HTMLElement>(".prose-post-body");
    if (!body || body.dataset.enhanced) return;
    body.dataset.enhanced = "1";

    // Copy traducido, puesto por el .astro en data-* (ver el comentario alla).
    const COPY = body.dataset.copy ?? "";
    const COPIED = body.dataset.copied ?? "";
    const COPY_ERROR = body.dataset.copyError ?? "";
    const COPY_ARIA = body.dataset.copyAria ?? "";
    const PLAINTEXT = body.dataset.plaintext ?? "";
    const HEADING_ANCHOR = body.dataset.headingAnchor ?? "";

    /** Reemplaza los marcadores {asi} del copy que llega por data-*. */
    const fill = (template: string, values: Record<string, string>) =>
      template.replace(
        /\{(\w+)\}/g,
        (match, key: string) => values[key] ?? match,
      );

    // ---- Bloques de codigo -------------------------------------------------
    // Shiki ya deja el lenguaje en data-language, asi que la barra se monta
    // sobre el <pre> existente sin tocar los .mdx ni el tema.
    const ICON_COPY =
      '<svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M14 5.5A2.5 2.5 0 0 0 11.5 3h-6A2.5 2.5 0 0 0 3 5.5v6A2.5 2.5 0 0 0 5.5 14"/></svg>';
    const ICON_CHECK =
      '<svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

    body.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
      const raw = pre.dataset.language ?? "plaintext";
      const language = raw === "plaintext" ? PLAINTEXT : raw;

      const wrapper = document.createElement("figure");
      wrapper.className = "code-block";
      wrapper.dataset.lang = language;

      const chrome = document.createElement("figcaption");
      chrome.className = "code-chrome";
      chrome.innerHTML = `<span class="code-id"><i class="code-dot"></i><i class="code-dot-idle"></i><i class="code-dot-idle"></i><span class="code-lang">${language}</span></span>`;

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.dataset.tip = COPY;
      button.setAttribute("aria-label", fill(COPY_ARIA, { language }));
      button.innerHTML = ICON_COPY + ICON_CHECK;

      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener("click", async () => {
        const code = pre.querySelector("code")?.textContent ?? "";
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.state = "copied";
          button.dataset.tip = COPIED;
        } catch {
          button.dataset.state = "error";
          button.dataset.tip = COPY_ERROR;
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          delete button.dataset.state;
          button.dataset.tip = COPY;
        }, 1800);
      });

      chrome.append(button);
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(pre, chrome);
    });

    // ---- Anclas de heading -------------------------------------------------
    // Reusa los ids que ya genera Astro (los mismos que consume el indice).
    body
      .querySelectorAll<HTMLHeadingElement>("h2[id], h3[id]")
      .forEach((heading) => {
        const anchor = document.createElement("a");
        anchor.className = "heading-anchor";
        anchor.href = `#${heading.id}`;
        anchor.textContent = "#";
        anchor.setAttribute(
          "aria-label",
          fill(HEADING_ANCHOR, { heading: heading.textContent ?? "" }),
        );
        heading.prepend(anchor);
      });

    // ---- Tablas ------------------------------------------------------------
    // Sin el marco con scroll propio, una tabla ancha desborda la columna.
    body.querySelectorAll("table").forEach((table) => {
      const wrapper = document.createElement("div");
      wrapper.className = "table-wrap";
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.append(table);
    });
  });
</script>
