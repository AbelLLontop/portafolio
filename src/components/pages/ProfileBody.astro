  }

  .plat-cards a:hover {
    border-color: var(--brand, var(--acc));
  }

  /* flex: none: con un texto largo al lado, la fila lo aplastaba de ancho. */
  .plat-cards i {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--brand, var(--acc)) 16%, transparent);
    color: var(--brand, var(--acc));
  }

  .plat-cards i :global(svg) {
    width: 20px;
    height: 20px;
  }

  .plat-cards b {
    display: block;
    font-size: 16px;
  }

  .plat-cards small {
    font-size: 12px;
    color: var(--mute);
  }

  .embeds {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .notice {
    margin: 8px 0 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--mute);
  }

  .gal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .gal figure {
    margin: 0;
  }

  .gal figure.wide {
    grid-column: 1 / -1;
  }

  .gal :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .gal figcaption {
    margin-top: 6px;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--mute);
  }

  @media (max-width: 960px) {
    .banner-in {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    /* Con containment de ancho, el bloque no tiene ancho propio: en columna
       tiene que estirarse, si no se encoge a cero y el texto cae palabra por
       palabra. */
    .banner-text {
      align-self: stretch;
    }

    .banner-in :global(.banner-avatar) {
      width: 84px;
      height: 84px;
    }

    .about,
    .st {
      grid-template-columns: minmax(0, 1fr);
    }

    .gal {
      grid-template-columns: minmax(0, 1fr);
    }

    .plats {
      margin-left: 0;
    }

    .song {
      grid-template-columns: 26px 40px minmax(0, 1fr) 48px;
    }
  }
</style>

<script>
  // Pestañas y copiar. Un solo listener en `document` (el módulo corre una
  // vez con el router); cada página trae sus pestañas nuevas.
  const select = (id: string, focus = false) => {
    const tab = document.querySelector<HTMLElement>(
      `[role="tab"][data-tab="${id}"]`,
    );
    if (!tab) return false;
    document.querySelectorAll<HTMLElement>('[role="tab"]').forEach((other) => {
      const on = other === tab;
      other.setAttribute("aria-selected", String(on));
      const panel = document.getElementById(
        other.getAttribute("aria-controls") ?? "",
      );
      if (panel) panel.hidden = !on;
    });
    if (focus) tab.focus();
    return true;
  };

  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const tab = target.closest<HTMLElement>('[role="tab"][data-tab]');
    if (tab?.dataset.tab) {
      select(tab.dataset.tab);
      // replaceState con el estado actual: el router de Astro guarda el suyo
      // en history.state y no hay que pisarlo.
      history.replaceState(history.state, "", `#${tab.dataset.tab}`);
      // Al cambiar de pestaña, la vista vuelve al borde de las pestañas.
      const tabs = tab.closest(".tabs") as HTMLElement | null;
      const stage = document.getElementById("stage");
      if (tabs && stage && stage.scrollTop > tabs.offsetTop) {
        stage.scrollTop = tabs.offsetTop;
      }
      return;
    }

    const copy = target.closest<HTMLButtonElement>("[data-copy]");
    if (copy) {
      const text =
        copy.closest(".prompt")?.querySelector("pre")?.textContent ?? "";
      const original = copy.textContent;
      navigator.clipboard?.writeText(text).then(() => {
        copy.textContent = copy.dataset.copied ?? original;
        setTimeout(() => (copy.textContent = original), 1600);
      });
    }
  });

  document.addEventListener("keydown", (event) => {
    const tab = (event.target as Element).closest<HTMLElement>('[role="tab"]');
    if (!tab || (event.key !== "ArrowRight" && event.key !== "ArrowLeft"))
      return;
    const all = [...document.querySelectorAll<HTMLElement>('[role="tab"]')];
    const next =
      all[
        (all.indexOf(tab) + (event.key === "ArrowRight" ? 1 : all.length - 1)) %
          all.length
      ];
    if (next.dataset.tab) select(next.dataset.tab, true);
  });

  document.addEventListener("astro:page-load", () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (id) select(id);
  });
</script>
