  a.hito:hover b {
    color: var(--acc);
  }

  .hito i {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand, var(--acc)) 16%, transparent);
    color: var(--brand, var(--acc));
