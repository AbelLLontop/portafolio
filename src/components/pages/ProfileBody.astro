  .st h3 {
    margin: 0 0 12px;
    font-size: clamp(24px, 2.3vw, 36px);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: "wdth" 78;
  }

  .st p {
    margin: 0 0 10px;
    font-family: system-ui, sans-serif;
