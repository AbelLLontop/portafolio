  .st::before {
    counter-increment: step;
    content: counter(step, decimal-leading-zero);
    position: absolute;
    top: -2px;
    left: -17px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--acc);
    border-radius: 50%;
    background: var(--bg);
    color: var(--acc);
