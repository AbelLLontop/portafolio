---
// El cuerpo del listado vive acá y no en la página para que las dos rutas
// (`/proyectos` y `/en/projects`) compartan el mismo markup.
import ProjectRow from "../astro/ProjectRow.astro";
import ScrollReveal from "../react/ScrollReveal.tsx";
import { getPublishedProjects } from "../../lib/projects.ts";
import { useTranslations, type Lang } from "../../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getPublishedProjects();
---

<main class="mx-auto max-w-5xl px-4 py-12">
  <ScrollReveal client:visible>
    <p class="section-label">{t("projects.label")}</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-[-0.02em] text-zinc-100 md:text-5xl">
      {t("projects.title")}
    </h1>
    <p class="mt-3 max-w-[52ch] leading-relaxed" style="color: var(--dim);">
      {t("projects.intro")}
    </p>
    {/* Los .mdx no se traducen: se avisa antes de entrar a uno. */}
    {lang !== "es" && (
      <p class="mt-4 flex items-center gap-2 font-mono text-micro tracking-ui text-faint">
        <span
          aria-hidden="true"
          class="h-px w-5"
          style="background: var(--line);"
        ></span>
        {t("projects.spanishNotice")}
      </p>
    )}
  </ScrollReveal>

  <ScrollReveal client:visible delay={0.05} className="mt-10">
    <div class="border-b" style="border-color: var(--line);">
      {projects.map((project, index) => (
        <ProjectRow project={project} lang={lang} index={index} />
      ))}
    </div>
    <p class="mt-6 font-mono text-micro uppercase tracking-label text-faint">
      {t("projects.soonLabel")} · {t("projects.soon")}
    </p>
  </ScrollReveal>
</main>
