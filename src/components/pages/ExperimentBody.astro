---
// La página de un experimento. El texto (el cuerpo del .mdx) entra por el slot;
// todo lo demás sale del frontmatter, así todos los experimentos comparten
// diseño y agregar uno es escribir un .mdx.
import { Image } from "astro:assets";
import EmbedFacade from "../astro/EmbedFacade.astro";
import ScrollReveal from "../react/ScrollReveal.tsx";
import { formatPostDate } from "../../lib/dates.ts";
import type { Experiment } from "../../lib/experiments.ts";
import {
  soundcloudEmbedUrl,
  youtubeEmbedUrl,
  youtubeThumbUrl,
} from "../../lib/embeds.ts";
import { interpolate, useTranslations, type Lang } from "../../i18n/index.ts";
import { pathFor } from "../../i18n/routes.ts";

interface Props {
  experiment: Experiment;
  lang: Lang;
}

const { experiment, lang } = Astro.props;
const t = useTranslations(lang);
const {
  title,
  date,
  tags,
  ai,
  banner,
  bannerAlt,
  avatar,
  avatarAlt,
  facts,
  links,
  soundcloud,
  videos,
  gallery,
} = experiment.data;

const notice = (service: string) =>
  interpolate(t("experiment.embedNotice"), { service });
---

<main class="mx-auto max-w-5xl px-4 py-10">
  <a
    href={pathFor("experiments", lang)}
    class="inline-flex items-center gap-2 font-mono text-ui tracking-ui transition-colors hover:text-accent"
    style="color: var(--dim);"
  >
    <span aria-hidden="true">&#8592;</span>
    {t("experiment.back")}
  </a>

  <ScrollReveal client:visible y={0}>
    <div
      class="mt-5 overflow-hidden rounded-lg border"
      style="border-color: var(--line);"
    >
      <Image
        src={banner}
        alt={bannerAlt}
        width={1400}
        class="h-44 w-full object-cover sm:h-60 md:h-72"
        loading="eager"
      />
    </div>
    <div class="relative flex items-end gap-5 px-4 sm:px-6">
      <Image
        src={avatar}
        alt={avatarAlt}
        width={224}
        height={224}
        class="-mt-10 h-24 w-24 shrink-0 rounded-full border-4 object-cover sm:-mt-12 sm:h-28 sm:w-28"
        style="border-color: var(--bg);"
        loading="eager"
      />
      <div class="min-w-0 pb-1 pt-4">
        <p class="font-mono text-micro uppercase tracking-label text-faint">
          {formatPostDate(date, lang)}
        </p>
        <h1 class="font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
          {title}
        </h1>
      </div>
    </div>
    <ul class="mt-5 flex flex-wrap items-center gap-2">
      {tags.map((tag) => (
        <li
          class="rounded-full border px-2.5 py-0.5 font-mono text-micro text-dim"
          style="border-color: var(--line);"
        >
          {tag}
        </li>
      ))}
      {ai && (
        <li class="rounded-full border border-accent/40 px-2.5 py-0.5 font-mono text-micro text-accent">
          {t("experiments.aiChip")}
        </li>
      )}
      {lang !== "es" && (
        <li class="font-mono text-micro tracking-ui text-faint">
          {t("experiments.spanishNotice")}
        </li>
      )}
    </ul>
  </ScrollReveal>

  <div class="mt-12 gap-12 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="min-w-0">
      <p class="section-label">{t("experiment.about")}</p>
      <div class="prose-post-body mt-4 max-w-[68ch]">
        <slot />
      </div>

      {soundcloud && (
        <section style="margin-top: var(--section-y);">
          <p class="section-label">{t("experiment.listen")}</p>
          <div class="mt-4">
            <EmbedFacade
              kind="audio"
              src={soundcloudEmbedUrl(soundcloud)}
              title={title}
              label={t("experiment.playSoundcloud")}
              cover={avatar}
            />
          </div>
          <p class="mt-3 font-mono text-micro tracking-ui text-faint">
            {notice("SoundCloud")}
          </p>
        </section>
      )}

      {videos.length > 0 && (
        <section style="margin-top: var(--section-y);">
          <p class="section-label">{t("experiment.videos")}</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {videos.map((video) => (
              <EmbedFacade
                kind="video"
                src={youtubeEmbedUrl(video.id)}
                title={video.title}
                label={interpolate(t("experiment.play"), {
                  title: video.title,
                })}
                thumb={youtubeThumbUrl(video.id)}
              />
            ))}
          </div>
          <p class="mt-3 font-mono text-micro tracking-ui text-faint">
            {notice("YouTube")}
          </p>
        </section>
      )}

      {gallery.length > 0 && (
        <section style="margin-top: var(--section-y);">
          <p class="section-label">{t("experiment.design")}</p>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            {gallery.map((item) => (
              <figure class:list={[item.wide && "sm:col-span-2"]}>
                <div
                  class="overflow-hidden rounded-lg border"
                  style="border-color: var(--line);"
                >
                  <Image
                    src={item.src}
                    alt={item.alt}
                    width={item.wide ? 1400 : 700}
                    class="h-auto w-full"
                  />
                </div>
                <figcaption class="mt-2 text-sm leading-relaxed text-dim">
                  {item.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>

    <aside class="mt-12 lg:mt-0">
      <div class="lg:sticky lg:top-24">
        <p class="section-label">{t("experiment.facts")}</p>
        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2.5 text-sm">
          {facts.map((fact) => (
            <>
              <dt class="pt-0.5 font-mono text-micro uppercase tracking-label text-faint">
                {fact.label}
              </dt>
              <dd class="text-zinc-300">{fact.value}</dd>
            </>
          ))}
        </dl>

        <p class="section-label" style="margin-top: var(--section-y);">
          {t("experiment.links")}
        </p>
        <ul class="mt-3 border-t" style="border-color: var(--line);">
          {links.map((link) => (
            <li class="border-b" style="border-color: var(--line);">
              <a
                href={link.url}
                target="_blank"
                rel="noreferrer"
                class="flex items-center justify-between py-2.5 font-mono text-ui tracking-ui text-dim transition-colors hover:text-accent"
              >
                {link.label}
                <span aria-hidden="true">&#8599;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</main>
