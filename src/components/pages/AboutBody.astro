---
// El cuerpo de Sobre mí vive acá y no en la página para que las dos rutas
// (`/sobre-mi` y `/en/about`) compartan el mismo markup.
import TechBadge from "../astro/TechBadge.astro";
import ScrollReveal from "../react/ScrollReveal.tsx";
import { STACK as stack } from "../../lib/profile.ts";
import { useTranslations, type Lang } from "../../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="mx-auto max-w-5xl px-4 py-14 md:py-20">
  <ScrollReveal client:visible>
    <p class="section-label">{t("about.label")}</p>

    <div class="mt-10 flex flex-col-reverse items-center gap-12 md:flex-row-reverse md:items-center md:gap-16">
      <div class="min-w-0">
        <h1 class="about-headline font-display font-extrabold text-zinc-100">
          {t("about.headlineName")}
          <br />
          <span style="color: var(--dim);">{t("about.headlineRole")}</span>
        </h1>
        <p class="mt-6 max-w-prose leading-relaxed" style="color: var(--dim);">
          {t("about.intro")}
        </p>
        <p class="mt-4 max-w-prose leading-relaxed" style="color: var(--dim);">
          {t("about.body")}
        </p>
      </div>

      <div class="orbit shrink-0" aria-hidden="true">
        <span class="orbit-glow"></span>
        <span class="orbit-ring orbit-ring-outer">
          <i class="orbit-body"></i>
        </span>
        <span class="orbit-ring orbit-ring-inner">
          <i class="orbit-body orbit-body-small"></i>
        </span>
        <img
          src="/images/abelitolll-head.svg"
          alt=""
          width="192"
          height="192"
          class="orbit-core h-32 w-32 md:h-40 md:w-40"
        />
      </div>
    </div>
  </ScrollReveal>
</section>

<section class="mx-auto max-w-5xl px-4 pb-16 md:pb-24">
  <ScrollReveal client:visible y={32}>
    <p class="section-label">{t("about.stackLabel")}</p>
    <h2 class="mt-3 font-display text-2xl font-semibold tracking-[-0.01em] text-zinc-100">
      {t("about.stackTitle")}
    </h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {stack.map((tech) => (
        <TechBadge name={tech.name} iconKey={tech.iconKey} size="md" />
      ))}
    </ul>
  </ScrollReveal>

  <ScrollReveal
    client:visible
    y={24}
    className="mt-12 flex flex-col items-start gap-4 border-t border-[var(--line)] pt-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <p class="max-w-prose" style="color: var(--dim);">
      {t("about.closing")}
    </p>
    <span class="inline-flex w-fit shrink-0 items-center gap-1.5 rounded-full border border-accent/40 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-accent">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
      {t("about.badge")}
    </span>
  </ScrollReveal>
</section>

<style>
  .about-headline {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Decoracion orbital: dos anillos girando en sentidos opuestos con un
     cuerpo luminoso cada uno. Todo CSS, sin assets nuevos ni JS. */
  .orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: 17rem;
    height: 17rem;
  }

  @media (min-width: 768px) {
    .orbit {
      width: 20rem;
      height: 20rem;
    }
  }

  .orbit-glow,
  .orbit-ring,
  .orbit-core {
    grid-area: 1 / 1;
  }

  .orbit-glow {
    width: 70%;
    height: 70%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 18%, transparent),
      transparent 70%
    );
    animation: orbit-breathe 7s ease-in-out infinite;
  }

  .orbit-ring {
    position: relative;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .orbit-ring-outer {
    width: 100%;
    height: 100%;
    animation: orbit-spin 22s linear infinite;
  }

  .orbit-ring-inner {
    width: 68%;
    height: 68%;
    border-style: dashed;
    animation: orbit-spin 15s linear infinite reverse;
  }

  /* El cuerpo cuelga del borde del anillo, asi que gira con el. */
  .orbit-body {
    position: absolute;
    top: -4px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 14px var(--color-accent);
  }

  .orbit-body-small {
    top: -3px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    background: var(--go);
    box-shadow: 0 0 10px var(--go);
  }

  .orbit-core {
    position: relative;
    animation: orbit-float 6s ease-in-out infinite;
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-float {
    0%,
    100% {
      transform: translateY(-4px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @keyframes orbit-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(1);
    }
    50% {
      opacity: 0.9;
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring-outer,
    .orbit-ring-inner,
    .orbit-core,
    .orbit-glow {
      animation: none;
    }
  }
</style>
