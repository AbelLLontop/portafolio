---
// El cuerpo del listado vive acá y no en la página para que las dos rutas
// (`/blog` y `/en/blog`) compartan el mismo markup.
import BlogList, { type BlogListPost } from "../react/BlogList";
import ScrollReveal from "../react/ScrollReveal.tsx";
import { formatPostDate } from "../../lib/dates.ts";
import { getPostNumbers, getPublishedPosts } from "../../lib/posts.ts";
import { pickStrings, useTranslations, type Lang } from "../../i18n/index.ts";
import { pathFor } from "../../i18n/routes.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getPublishedPosts();
const numbers = await getPostNumbers();

const listPosts: BlogListPost[] = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  summary: post.data.summary,
  tags: post.data.tags,
  number: numbers.get(post.id) ?? 0,
  formattedDate: formatPostDate(post.data.date, lang),
}));

// La isla recibe su copy por props en vez de importar el diccionario: así el
// bundle del cliente lleva solo el idioma de esta página.
const strings = pickStrings(lang, [
  "blog.searchLabel",
  "blog.searchPlaceholder",
  "blog.count",
  "blog.countFiltered",
  "blog.pageInfo",
  "blog.noResults",
  "blog.noResultsHint",
  "blog.prev",
  "blog.next",
] as const);
---

<main class="mx-auto max-w-5xl px-4 py-12">
  <ScrollReveal client:visible>
    <p class="section-label">{t("blog.label")}</p>
    <div class="mt-3 flex items-center gap-3">
      <img
        src="/images/abelitolll-head.svg"
        alt=""
        width="40"
        height="40"
        class="h-9 w-9 shrink-0"
      />
      <h1 class="font-display text-4xl font-bold tracking-[-0.02em] text-zinc-100 md:text-5xl">
        {t("blog.title")}
      </h1>
    </div>
    <p class="mt-3 max-w-[52ch] leading-relaxed" style="color: var(--dim);">
      {t("blog.intro")}
    </p>
    {/* Los .mdx no se traducen: en la versión inglesa se avisa antes de que
        el lector haga clic y se encuentre un muro de español. */}
    {lang !== "es" && (
      <p class="mt-4 flex items-center gap-2 font-mono text-[0.72rem] tracking-[0.06em]" style="color: var(--faint);">
        <span aria-hidden="true" class="h-px w-5" style="background: var(--line);"></span>
        {t("blog.spanishNotice")}
      </p>
    )}
  </ScrollReveal>
  {listPosts.length === 0 ? (
    <ScrollReveal client:visible delay={0.05} className="mt-8 rounded-xl border border-dashed border-[var(--line)] p-8 text-center">
      <p class="text-zinc-300">{t("blog.emptyTitle")}</p>
      <p class="mt-2 text-sm text-zinc-400">
        {t("blog.emptyHint")}
      </p>
    </ScrollReveal>
  ) : (
    <ScrollReveal client:visible delay={0.05} className="mt-8">
      <BlogList
        posts={listPosts}
        blogPath={pathFor("blog", lang)}
        strings={strings}
        client:visible
      />
    </ScrollReveal>
  )}
</main>
