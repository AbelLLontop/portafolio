---
// El 404, dentro de la misma ventana: la biblioteca y la radio siguen ahí, así
// que alcanza con decir que la pista no existe y ofrecer el inicio. La ruta
// pedida la escribe el script (Vercel sirve un único 404.html).
import { useTranslations } from "../../i18n/index.ts";
import { pathFor } from "../../i18n/routes.ts";

const lang = "es" as const;
const t = useTranslations(lang);
---

<section class="nf theme-paper">
  <p class="kicker">{t("notFound.label")}</p>
  <h1 class="giant nf-code" aria-hidden="true">
    4<span class="r">0</span>4
  </h1>
  <h2 class="nf-title">{t("notFound.title")}</h2>
  <p class="nf-path">
    <code data-nf-path>/</code>
  </p>
  <p class="nf-text">{t("notFound.text")}</p>
  <div class="nf-acts">
    <a class="btn solid" href={pathFor("home", lang)}>
      {t("notFound.ctaHome")} →
    </a>
    <a class="btn" href={pathFor("radio", lang)}>
      {t("player.list")}
    </a>
  </div>
</section>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100% - 28px);
    margin: 14px;
    padding: 6vh 5vw;
    border-radius: 14px;
  }

  .nf-code {
    margin-top: 2vh;
    font-size: clamp(110px, 18vw, 260px);
  }

  .nf-title {
    margin: 3vh 0 0;
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .nf-path {
    margin: 10px 0 0;
  }

  .nf-path code {
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--card);
    font-family: var(--mono);
    font-size: 13px;
    word-break: break-all;
  }

  .nf-text {
    max-width: 46ch;
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--soft);
  }

  .nf-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4vh;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // textContent y no innerHTML: la ruta la escribe quien visita.
    document
      .querySelectorAll<HTMLElement>("[data-nf-path]")
      .forEach((el) => (el.textContent = window.location.pathname));
  });
</script>
