---
const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/blog", label: "Blog" },
];
---

<header class="border-b border-zinc-800">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="font-mono text-lg font-semibold text-zinc-100">abelitolll</a>
    <nav>
      <ul class="flex gap-6">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-zinc-300 transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
