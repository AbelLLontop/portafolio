---
import Wordmark from "../react/Wordmark.tsx";

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/sobre-mi", label: "Sobre mí" },
  { href: "/blog", label: "Blog" },
];
---

<header
  class="sticky top-0 z-50 border-b bg-zinc-950/70 backdrop-blur-md"
  style="border-color: var(--line);"
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-center gap-3 transition-opacity hover:opacity-80">
      <img src="/images/abelitolll-head.svg" alt="" width="32" height="32" class="h-8 w-8 shrink-0" />
      <Wordmark size="sm" client:visible />
    </a>
    <nav>
      <ul class="flex gap-6">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="font-mono text-[0.8rem] tracking-[0.06em] text-zinc-400 transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
