---
import Wordmark from "../react/Wordmark.tsx";
import LanguageSwitch from "./LanguageSwitch.astro";
import { useTranslations, type Lang } from "../../i18n/index.ts";
import { NAV_ROUTES, pathFor, type Route } from "../../i18n/routes.ts";

interface Props {
  lang: Lang;
  /** La página actual, para que el switch de idioma caiga en su equivalente. */
  route: Route;
  slug?: string;
}

const { lang, route, slug } = Astro.props;
const t = useTranslations(lang);

// Una nota pertenece al blog: estando en ella, "Blog" es la sección actual.
const navLinks = NAV_ROUTES.map((key) => ({
  href: pathFor(key, lang),
  label: t(`nav.${key}`),
  current: key === route || (key === "blog" && route === "post"),
}));
---

<header
  class="sticky top-0 z-50 border-b bg-zinc-950/70 backdrop-blur-md"
  style="border-color: var(--line);"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <a
      href={pathFor("home", lang)}
      class="flex min-w-0 items-center gap-3 transition-opacity hover:opacity-80"
    >
      <img
        src="/images/abelitolll-head.svg"
        alt=""
        width="32"
        height="32"
        class="brand-mark h-8 w-8 shrink-0"
      />
      <Wordmark size="sm" client:visible />
    </a>

    <!-- Desktop: los links en linea. Mobile: solo el boton, para que la
         barra nunca crezca a dos filas. -->
    <div class="flex items-center gap-5">
      <nav class="hidden sm:block">
        {/* items-center: sin eso los <li> se estiran a la altura del <ul> y el
            enlace queda pegado arriba de su caja, media línea más alto que el
            switch de idioma que va al lado. */}
        <ul class="flex items-center gap-6">
          {navLinks.map((link) => (
            <li>
              {/* La página actual va en claro y con un filete de acento debajo
                  (el mismo lenguaje de las etiquetas de sección); el resto,
                  en gris, se enciende al pasar el cursor. */}
              <a
                href={link.href}
                aria-current={link.current ? "page" : undefined}
                class:list={[
                  "relative font-mono text-ui tracking-ui transition-colors",
                  link.current
                    ? "text-zinc-100 after:absolute after:-bottom-1.5 after:left-0 after:h-px after:w-full after:bg-accent"
                    : "text-dim hover:text-accent",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <LanguageSwitch
        lang={lang}
        route={route}
        slug={slug}
        class="lang-switch-desktop"
      />

      {/* Visible también en móvil: es un control de un toque, no cabe mejor
          escondido dentro del menú. El icono muestra el tema al que se pasa. */}
      <button
        type="button"
        class="theme-toggle"
        data-theme-toggle
        aria-label={t("nav.theme")}
        title={t("nav.theme")}
      >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
        </svg>
      </button>

      <button
        type="button"
        id="nav-toggle"
        class="nav-toggle"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
        aria-controls="nav-mobile"
        data-label-open={t("nav.openMenu")}
        data-label-close={t("nav.closeMenu")}
      >
        <span class="nav-bar"></span>
        <span class="nav-bar"></span>
        <span class="nav-bar"></span>
      </button>
    </div>
  </div>

  <!-- Panel absoluto: se superpone al contenido en vez de empujar el header. -->
  <nav id="nav-mobile" class="nav-mobile" hidden>
    <ul class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={link.current ? "page" : undefined}
            class:list={[
              "block rounded-sm px-2 py-2.5 font-mono text-sm tracking-ui transition-colors",
              link.current ? "text-accent" : "text-zinc-300 hover:text-accent",
            ]}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="flex items-center justify-between gap-4 px-2 py-2.5">
        <span
          class="font-mono text-sm tracking-ui"
          style="color: var(--faint);"
        >
          {t("nav.language")}
        </span>
        <LanguageSwitch lang={lang} route={route} slug={slug} />
      </li>
    </ul>
  </nav>
</header>

<style>
  /* La cabeza del logo es crema: sobre fondo claro se pierde, así que en el
     tema claro va sobre una ficha oscura. En oscuro va suelta. */
  :global(html[data-theme="light"]) .brand-mark {
    box-sizing: border-box;
    padding: 3px;
    border-radius: 8px;
    background: #09090b;
  }

  .theme-toggle {
    display: grid;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--tint-2);
    color: var(--dim);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--line));
  }

  /* En oscuro se ofrece el sol (pasar a claro); en claro, la luna. Ambos
     ocupan el mismo sitio, así que el botón no cambia de tamaño. */
  .theme-toggle svg {
    grid-area: 1 / 1;
  }

  .theme-toggle .icon-moon {
    display: none;
  }

  :global(html[data-theme="light"]) .theme-toggle .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .theme-toggle .icon-moon {
    display: block;
  }

  /* La visibilidad va aca y no con utilidades `sm:hidden`: el estilo con
     scope de Astro gana en especificidad y dejaria el boton visible. */
  .nav-toggle {
    display: none;
    height: 2rem;
    width: 2rem;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-accent) 5%, transparent);
    transition: border-color 0.2s ease;
  }

  .nav-toggle:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--line));
  }

  .nav-bar {
    display: block;
    height: 1.5px;
    width: 1rem;
    background: var(--dim);
    transition:
      transform 0.2s ease,
      opacity 0.15s ease,
      background-color 0.2s ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-bar {
    background: var(--color-accent);
  }

  .nav-toggle[aria-expanded="true"] .nav-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .nav-mobile {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    backdrop-filter: blur(8px);
  }

  .nav-mobile li + li {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 639px) {
    .nav-toggle {
      display: flex;
    }
  }

  @media (min-width: 640px) {
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  // El router de cliente reemplaza el <body> sin recargar el documento, así
  // que este módulo corre una sola vez y las referencias a elementos que
  // guardara quedarían apuntando al header de la página anterior. De ahí la
  // forma: todo cuelga de `document` (que sobrevive al swap) y el header se
  // busca al usarlo, no al cargar. Así tampoco hay que volver a colgar nada en
  // `astro:page-load`, que iría acumulando listeners duplicados.
  const panel = () => document.getElementById("nav-mobile");
  const toggle = () => document.getElementById("nav-toggle");

  const setOpen = (open: boolean) => {
    const button = toggle();
    const menu = panel();
    if (!button || !menu) return;

    // Las etiquetas llegan por data-* porque este script se empaqueta aparte y
    // no puede leer props de Astro; `define:vars` lo volveria inline y sin TS.
    const label = open ? button.dataset.labelClose : button.dataset.labelOpen;

    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", label ?? "");
    menu.hidden = !open;
  };

  // Cambio de tema: delegado en `document` por la misma razón de arriba. El
  // atributo lo lee el CSS y el script de BaseLayout lo repone al navegar.
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    if (!target.closest("[data-theme-toggle]")) return;
    const root = document.documentElement;
    const next = root.dataset.theme === "light" ? "dark" : "light";
    if (next === "light") root.dataset.theme = "light";
    else delete root.dataset.theme;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Sin almacenamiento el tema vale solo para esta sesión.
    }
  });

  document.addEventListener("click", (event) => {
    const button = toggle();
    const menu = panel();
    if (!button || !menu) return;

    const target = event.target as Node;

    if (button.contains(target)) {
      setOpen(button.getAttribute("aria-expanded") !== "true");
      return;
    }

    // Cerrar al tocar fuera, para que el panel no se quede tapando el
    // contenido.
    if (!menu.hidden && !menu.contains(target)) setOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    const menu = panel();
    if (event.key !== "Escape" || !menu || menu.hidden) return;
    setOpen(false);
    toggle()?.focus();
  });

  // El panel abierto no hace falta cerrarlo al navegar: el header que llega
  // del servidor ya viene con el panel oculto.
</script>
