---
import { useTranslations, type Lang } from "../../i18n/index.ts";
import { FOOTER_ROUTES, pathFor } from "../../i18n/routes.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// Mismo mapa de rutas que el header: antes el pie tenía su propia lista y las
// dos podían irse separando.
const navLinks = FOOTER_ROUTES.map((key) => ({
  href: pathFor(key, lang),
  label: t(`nav.${key}`),
}));
---

<footer class="border-t bg-zinc-950/60 backdrop-blur-md" style="border-color: var(--line);">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6">
    <p class="font-mono text-xs tracking-[0.08em]" style="color: var(--faint);">
      &copy; {year} abelitolll
    </p>
    <nav>
      <ul class="flex gap-6">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="font-mono text-xs tracking-[0.08em] text-zinc-400 transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
