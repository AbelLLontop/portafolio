---
const year = new Date().getFullYear();

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/blog", label: "Blog" },
];
---

<footer class="border-t border-zinc-800">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-6">
    <p class="text-sm text-zinc-400">&copy; {year} abelitolll</p>
    <nav>
      <ul class="flex gap-6">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="text-sm text-zinc-400 transition-colors hover:text-accent">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
