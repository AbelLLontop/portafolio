---
import { CONTACTS } from "../../lib/profile.ts";
import { CONTACT_ICONS } from "../../lib/contact-icons.ts";
import { useTranslations, type Lang } from "../../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const contacts = CONTACTS.map((contact) => ({ ...contact, icon: CONTACT_ICONS[contact.key] }));
---

<section class="mx-auto max-w-5xl px-4 py-12 md:py-20">
  <p class="section-label">{t("contact.label")}</p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
    {t("contact.title")}
  </h2>
  <p class="mt-3 max-w-prose" style="color: var(--dim);">
    {t("contact.intro")}
  </p>
  <div class="mt-6 flex flex-wrap gap-4">
    {contacts.map((contact) => (
      <a
        href={contact.href}
        class="inline-flex items-center gap-2.5 rounded-lg border px-4 py-3 font-mono text-[0.78rem] tracking-[0.06em] text-zinc-200 transition-colors hover:border-accent hover:text-accent"
        style="border-color: var(--line); background: rgb(255 255 255 / 0.02);"
        target={contact.external ? "_blank" : undefined}
        rel={contact.external ? "noreferrer" : undefined}
      >
        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--go);"></span>
        <span class="[&>svg]:h-4 [&>svg]:w-4" set:html={contact.icon} />
        {contact.label}
      </a>
    ))}
  </div>
</section>
