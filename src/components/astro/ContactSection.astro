---
import githubIconRaw from "simple-icons/icons/github.svg?raw";
import linkedinIconRaw from "../../lib/icons/linkedin.svg?raw";

const githubIcon = githubIconRaw.replace("<svg ", '<svg fill="currentColor" ');
const linkedinIcon = linkedinIconRaw.replace("<svg ", '<svg fill="currentColor" ');

const mailIcon = `<svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6.75A1.5 1.5 0 0 1 4.5 5.25h15a1.5 1.5 0 0 1 1.5 1.5v10.5a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5V6.75Z"/><path stroke-linecap="round" stroke-linejoin="round" d="m3.75 7 7.386 5.166a1.5 1.5 0 0 0 1.728 0L20.25 7"/></svg>`;

const contacts = [
  { label: "Email", href: "mailto:a.llontopmeza@gmail.com", icon: mailIcon, external: false },
  { label: "GitHub", href: "https://github.com/AbelLLontop", icon: githubIcon, external: true },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/abelllontopmeza/",
    icon: linkedinIcon,
    external: true,
  },
];
---

<section class="mx-auto max-w-5xl px-4 py-12 md:py-20">
  <p class="section-label">Dónde encontrarme</p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
    Contacto
  </h2>
  <p class="mt-3 max-w-prose" style="color: var(--dim);">
    Si quieres hablar de algo que estoy construyendo, proponerme un proyecto o simplemente
    saludar, por aquí me encuentras.
  </p>
  <div class="mt-6 flex flex-wrap gap-4">
    {contacts.map((contact) => (
      <a
        href={contact.href}
        class="inline-flex items-center gap-2.5 rounded-lg border px-4 py-3 font-mono text-[0.78rem] tracking-[0.06em] text-zinc-200 transition-colors hover:border-accent hover:text-accent"
        style="border-color: var(--line); background: rgb(255 255 255 / 0.02);"
        target={contact.external ? "_blank" : undefined}
        rel={contact.external ? "noreferrer" : undefined}
      >
        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: var(--go);"></span>
        <span class="[&>svg]:h-4 [&>svg]:w-4" set:html={contact.icon} />
        {contact.label}
      </a>
    ))}
  </div>
</section>
