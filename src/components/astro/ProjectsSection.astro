---
import ProjectRow from "./ProjectRow.astro";
import { getPublishedProjects } from "../../lib/projects.ts";
import { useTranslations, type Lang } from "../../i18n/index.ts";
import { pathFor } from "../../i18n/routes.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = await getPublishedProjects();
---

<section class="section-y mx-auto max-w-5xl px-4">
  <p class="section-label">{t("projects.label")}</p>
  <h2 class="mt-3 font-display text-3xl font-bold tracking-[-0.02em] text-zinc-100 md:text-4xl">
    {t("projects.title")}
  </h2>
  {projects.length === 0 ? (
    <div class="project-placeholder hull-panel relative mt-6 flex flex-col gap-3 overflow-hidden p-8 transition-colors hover:border-accent/50">
      <span class="project-scan" aria-hidden="true"></span>
      <span class="relative inline-flex w-fit items-center gap-1.5 rounded-full border border-accent/40 px-3 py-1 font-mono text-micro uppercase tracking-label text-accent">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
        {t("projects.badge")}
      </span>
      <p class="relative max-w-prose text-zinc-300">
        {t("projects.placeholder")}
      </p>
      <p class="relative max-w-prose text-sm" style="color: var(--faint);">
        {t("projects.meanwhileBefore")}{" "}
        <a
          href={pathFor("blog", lang)}
          class="underline decoration-accent/50 underline-offset-4 hover:text-accent"
        >
          {t("projects.meanwhileLink")}
        </a>{" "}
        {t("projects.meanwhileAfter")}
      </p>
    </div>
  ) : (
    <div class="mt-6 border-b" style="border-color: var(--line);">
      {projects.map((project, index) => (
        <ProjectRow project={project} lang={lang} index={index} />
      ))}
      <a
        href={pathFor("projects", lang)}
        class="inline-flex py-5 font-mono text-ui tracking-ui text-dim transition-colors hover:text-accent"
      >
        {t("projects.viewAll")} <span aria-hidden="true">&#8594;</span>
      </a>
    </div>
  )}
</section>

<style>
  /* Anillo de órbita recortado por la esquina: el truco es que el padre
     recorta (overflow-hidden) un círculo mucho más grande que la tarjeta. */
  .project-placeholder::after {
    content: "";
    position: absolute;
    right: -70px;
    top: -70px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    border: 1px solid var(--line);
    opacity: 0.6;
    pointer-events: none;
  }

  /* Barra de obra: un hilo de acento recorre el borde inferior, como un
     indicador de progreso sin fin. Dice "en construcción" sin una palabra. */
  .project-scan {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 35%;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-accent),
      transparent
    );
    animation: project-scan 4.5s ease-in-out infinite;
  }

  @keyframes project-scan {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(300%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-scan {
      animation: none;
      display: none;
    }
  }
</style>
