---
import { monoIcon } from "../../lib/tech-icons";

interface Props {
  name: string;
  iconKey?: string;
  size?: "sm" | "md";
}

const { name, iconKey, size = "sm" } = Astro.props;
const icon = monoIcon(iconKey ?? name);

const sizeClass =
  size === "md"
    ? "gap-2.5 px-3.5 py-2 text-sm [&_svg]:h-5 [&_svg]:w-5"
    : "gap-1.5 px-3 py-1 text-ui [&_svg]:h-3.5 [&_svg]:w-3.5";
---

<li
  data-spot
  class={`inline-flex items-center rounded-full border font-mono tracking-ui transition-colors hover:border-accent hover:text-accent ${sizeClass}`}
  style="border-color: var(--line); color: var(--dim); background: var(--tint);"
>
  {icon && <span class="inline-flex" set:html={icon} />}
  <span>{name}</span>
</li>
