---
import { monoIcon } from "../../lib/tech-icons";

interface Props {
  name: string;
  iconKey?: string;
}

const { name, iconKey } = Astro.props;
const icon = monoIcon(iconKey ?? name);
---

<li class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800 px-3 py-1 text-xs text-zinc-400">
  {icon && <span class="[&>svg]:h-3.5 [&>svg]:w-3.5" set:html={icon} />}
  <span>{name}</span>
</li>
