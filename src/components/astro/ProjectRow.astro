---
// Una fila del listado de proyectos: captura a un lado y ficha al otro. A
// diferencia de las tarjetas de experimentos (cuadricula), cada proyecto ocupa
// el ancho completo, como un caso de estudio.
import { Image } from "astro:assets";
import TechBadge from "./TechBadge.astro";
import type { Project } from "../../lib/projects.ts";
import { formatPostDate } from "../../lib/dates.ts";
import { useTranslations, type Lang } from "../../i18n/index.ts";
import { pathFor } from "../../i18n/routes.ts";

interface Props {
  project: Project;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useTranslations(lang);
const { title, summary, date, status, stack, cover, coverAlt } = project.data;
---

<a
  href={pathFor("project", lang, project.id)}
  class="group grid items-center gap-6 border-t py-8 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] md:gap-10"
  style="border-color: var(--line);"
>
  <div
    class="overflow-hidden rounded-lg border transition-colors group-hover:border-accent"
    style="border-color: var(--line);"
  >
    <Image
      src={cover}
      alt={coverAlt}
      width={900}
      class="aspect-[16/10] w-full object-cover object-top"
    />
  </div>
  <div class="min-w-0">
    <p class="flex flex-wrap items-center gap-3 font-mono text-micro uppercase tracking-label text-faint">
      <span>{String(index + 1).padStart(2, "0")}</span>
      <span>{formatPostDate(date, lang)}</span>
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5",
          status === "live" ? "border-accent/40 text-accent" : "text-dim",
        ]}
        style={status === "live" ? undefined : "border-color: var(--line);"}
      >
        <span
          class:list={[
            "h-1.5 w-1.5 rounded-full",
            status === "live" ? "bg-accent" : "bg-zinc-500",
          ]}
        ></span>
        {t(
          status === "live" ? "projects.statusLive" : "projects.statusBuilding",
        )}
      </span>
    </p>
    <h2 class="mt-3 font-display text-2xl font-semibold text-zinc-100 transition-colors group-hover:text-accent md:text-3xl">
      {title}
    </h2>
    <p class="mt-3 leading-relaxed text-dim">{summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {stack.map((tech) => (
        <TechBadge name={tech} />
      ))}
    </ul>
    <p class="mt-6 font-mono text-ui tracking-ui text-dim transition-colors group-hover:text-accent">
      {t("projects.open")} <span aria-hidden="true">&#8594;</span>
    </p>
  </div>
</a>
