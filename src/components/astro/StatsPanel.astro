---
import { getCollection } from "astro:content";
import { STACK, YEARS_OF_EXPERIENCE } from "../../lib/profile.ts";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Solo datos verificables contra el propio repo: nada de porcentajes de skill
// inventados, que es justo lo que SPEC.md prohíbe.
const series = new Set(
  posts
    .map((post) => post.id.match(/^(desplegar-proyecto-[a-z]+)-\d+/)?.[1])
    .filter((id): id is string => Boolean(id)),
);

const cells = [
  { key: "experiencia", value: String(YEARS_OF_EXPERIENCE), unit: "años" },
  { key: "notas publicadas", value: String(posts.length), unit: "" },
  { key: "series técnicas", value: String(series.size), unit: "" },
  { key: "stack principal", value: String(STACK.length), unit: "tecnologías" },
];
---

<section class="mx-auto max-w-5xl px-4 py-12 md:py-16">
  <p class="section-label">En números</p>
  <div class="hull-grid mt-6 [grid-template-columns:repeat(auto-fit,minmax(10.5rem,1fr))]">
    {cells.map((cell) => (
      <div class="hull-cell">
        <p class="font-mono text-[0.63rem] uppercase tracking-[0.16em]" style="color: var(--faint);">
          {cell.key}
        </p>
        <p class="mt-1.5 font-display text-2xl font-semibold tracking-[-0.01em] text-zinc-100">
          {cell.value}
          {cell.unit && (
            <span class="ml-1 font-mono text-xs font-normal" style="color: var(--faint);">
              {cell.unit}
            </span>
          )}
        </p>
        <span class="stat-rule mt-3 block h-px w-0 bg-accent/60"></span>
      </div>
    ))}
  </div>
</section>

<style>
  /* Regla decorativa: crece al entrar en viewport. No representa un porcentaje. */
  .stat-rule {
    transition: width 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hull-cell.is-revealed .stat-rule {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-rule {
      transition: none;
      width: 100%;
    }
  }
</style>

<script>
  const cells = document.querySelectorAll<HTMLElement>(".hull-cell");
  if (cells.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = [...cells].indexOf(entry.target as HTMLElement);
          setTimeout(() => entry.target.classList.add("is-revealed"), index * 90);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    cells.forEach((cell) => observer.observe(cell));
  }
</script>
