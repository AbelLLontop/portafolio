---
import Wordmark from "../react/Wordmark.tsx";
import TerminalHero from "../react/TerminalHero.tsx";
---

<section class="mx-auto flex max-w-3xl flex-col gap-10 px-4 py-16 md:py-24">
  <div class="flex flex-col gap-4">
    <div class="flex items-center gap-4">
      <Wordmark size="lg" client:visible />
      <img
        src="/images/abelitolll-rocket.svg"
        alt=""
        width="96"
        height="96"
        class="hidden h-16 w-16 shrink-0 sm:block md:h-20 md:w-20"
      />
    </div>
    <p class="max-w-prose text-zinc-400">
      Desarrollador de software peruano. Construyo con apoyo de herramientas de IA y dejo
      notas técnicas en el camino.
    </p>
  </div>
  <!-- client:load: above-the-fold, único caso justificado fuera de client:visible -->
  <TerminalHero client:load />
</section>
