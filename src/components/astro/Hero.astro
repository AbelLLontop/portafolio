---
import { getCollection } from "astro:content";
import Wordmark from "../react/Wordmark.tsx";
import TerminalHero from "../react/TerminalHero.tsx";
import type { Block, RowValue } from "../react/TerminalHero.tsx";
import { CONTACTS, STACK, YEARS_OF_EXPERIENCE } from "../../lib/profile.ts";
import { formatPostDateShort } from "../../lib/dates.ts";
import { CONTACT_ICONS } from "../../lib/contact-icons.ts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Las respuestas de la consola salen de los mismos datos que renderiza el
// sitio (stack compartido y colección de blog), nunca de un texto duplicado.
const commands: Record<string, Block[]> = {
  whoami: [
    {
      kind: "prose",
      text: `Soy Abel Llontop, desarrollador de software peruano. Llevo ${YEARS_OF_EXPERIENCE} años construyendo aplicaciones escalables, automatizando procesos y optimizando sistemas críticos de negocio.`,
    },
    {
      kind: "rows",
      rows: [
        ["hago", "microservicios, APIs REST, integración de sistemas"],
        ["se me da bien", "grandes volúmenes de datos"],
        ["escribo", "cada despliegue, incluyendo lo que se rompió"],
      ],
    },
  ],
  stack: [
    { kind: "prose", text: "Esto es lo que uso en el día a día:" },
    {
      kind: "rows",
      rows: [
        ["día a día", STACK.map((tech) => tech.name).join(" · ")],
        ["infra", "docker · nginx · pm2 · postgres · certbot"],
        ["despliegue", "vercel · digitalocean"],
      ],
    },
  ],
  proyectos: [
    {
      kind: "prose",
      text: "Todavía no tengo proyectos publicados. El primero está en construcción: una app Node + PostgreSQL dockerizada, detrás de Nginx y con HTTPS que se renueva solo.",
    },
    {
      kind: "rows",
      rows: [
        ["publicados", "0"],
        ["en construcción", "1"],
        ["estado", "en integración"],
      ],
    },
  ],
  blog: [
    {
      kind: "prose",
      text: `Tengo ${posts.length} notas publicadas, escritas el mismo día que pasaron. Las últimas:`,
    },
    {
      kind: "entries",
      entries: posts.slice(0, 3).map((post, index) => ({
        number: posts.length - index,
        title: post.data.title,
        summary: post.data.summary,
        date: formatPostDateShort(post.data.date),
        href: "/blog/" + post.id,
      })),
    },
    {
      kind: "rows",
      rows: [["todas", { text: "ver el blog completo →", href: "/blog" }]] as [string, RowValue][],
    },
  ],
  contacto: [
    { kind: "prose", text: "Por acá me encuentras — los tres van directo desde esta consola:" },
    {
      kind: "channels",
      channels: CONTACTS.map((contact) => ({
        label: contact.label,
        display: contact.display,
        href: contact.href,
        external: contact.external,
        icon: CONTACT_ICONS[contact.key],
      })),
    },
  ],
};
---

<section class="mx-auto flex max-w-5xl flex-col gap-8 px-4 pb-12 pt-12 md:pb-14 md:pt-16">
  <div class="flex flex-col gap-5">
    <p class="font-mono text-[0.68rem] uppercase tracking-[0.3em]" style="color: var(--faint);">
      Lima · Perú · desarrollador de software
    </p>

    <div class="flex items-center gap-4">
      <Wordmark size="lg" client:visible />
      <img
        src="/images/abelitolll-rocket.svg"
        alt=""
        width="96"
        height="96"
        class="hidden h-16 w-16 shrink-0 sm:block md:h-20 md:w-20"
      />
    </div>

    <h1 class="hero-headline font-display font-extrabold text-zinc-100">
      Software que aguanta producción.<br />
      <span style="color: var(--dim);">Y las notas de cómo llegó ahí.</span>
    </h1>

    <p class="max-w-[46ch] leading-relaxed" style="color: var(--dim);">
      Construyo con apoyo de herramientas de IA y dejo notas técnicas en el camino — cada
      paso, incluyendo lo que se rompió.
    </p>
  </div>

  <!-- client:load: above-the-fold, único caso justificado fuera de client:visible -->
  <TerminalHero commands={commands} client:load />
</section>

<style>
  .hero-headline {
    font-size: clamp(1.9rem, 5.2vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
</style>
