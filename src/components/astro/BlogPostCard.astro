---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, date, summary } = post.data;

const formattedDate = date.toLocaleDateString("es-PE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a href={`/blog/${post.id}`} class="group block">
  <h2 class="text-lg font-semibold text-zinc-100 transition-colors group-hover:text-accent">
    {title}
  </h2>
  <p class="mt-1 text-sm text-zinc-500">{formattedDate}</p>
  {summary && <p class="mt-2 text-sm text-zinc-400">{summary}</p>}
</a>
