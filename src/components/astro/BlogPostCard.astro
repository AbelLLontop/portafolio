---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, date, summary, tags } = post.data;

const formattedDate = date.toLocaleDateString("es-PE", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<a
  href={`/blog/${post.id}`}
  class="group block rounded-lg border border-zinc-800 p-6 transition-colors hover:border-accent"
>
  <h2 class="text-xl font-semibold text-zinc-100 transition-colors group-hover:text-accent">
    {title}
  </h2>
  <p class="mt-1 text-sm text-zinc-400">{formattedDate}</p>
  {summary && <p class="mt-3 text-zinc-300">{summary}</p>}
  {tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li class="rounded-full border border-zinc-800 px-3 py-1 text-xs text-zinc-400">
          {tag}
        </li>
      ))}
    </ul>
  )}
</a>
