---
import type { CollectionEntry } from "astro:content";
import TechBadge from "./TechBadge.astro";
import githubIconRaw from "simple-icons/icons/github.svg?raw";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, stack, githubUrl, liveUrl } = project.data;
const githubIcon = githubIconRaw.replace("<svg ", '<svg fill="currentColor" ');
---

<article class="group rounded-lg border border-zinc-800 p-6 transition-colors hover:border-accent">
  <h3 class="text-lg font-semibold text-zinc-100 transition-colors group-hover:text-accent">
    {name}
  </h3>
  <p class="mt-2 text-zinc-300">{description}</p>
  {stack.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2">
      {stack.map((tech) => (
        <TechBadge name={tech} />
      ))}
    </ul>
  )}
  {(githubUrl || liveUrl) && (
    <div class="mt-4 flex gap-4 text-sm text-zinc-400">
      {githubUrl && (
        <a
          href={githubUrl}
          class="inline-flex items-center gap-1.5 hover:text-accent"
          target="_blank"
          rel="noreferrer"
        >
          <span class="[&>svg]:h-4 [&>svg]:w-4" set:html={githubIcon} />
          GitHub
        </a>
      )}
      {liveUrl && (
        <a
          href={liveUrl}
          class="hover:text-accent"
          target="_blank"
          rel="noreferrer"
        >
          Demo ↗
        </a>
      )}
    </div>
  )}
</article>
