---
import { useTranslations, type Lang } from "../../i18n/index.ts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  lang: Lang;
}

const { headings, lang } = Astro.props;
const t = useTranslations(lang);
---

{headings.length > 0 && (
  <nav class="toc" aria-label={t("toc.label")}>
    {/* Sin -ml-3 (que anulaba el pl-3 del indice) el titulo deja de pegarse
          a la linea; el pl-0.5 lo cuadra con el borde de 2px de los items. */}
    <p class="section-label mb-3 pl-0.5">{t("toc.title")}</p>
    <ul class="space-y-0.5">
      {headings.map((heading) => (
        <li>
          <a
            href={`#${heading.slug}`}
            class="toc-link"
            data-depth={heading.depth}
            data-slug={heading.slug}
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // El indice vive solo en los posts, pero con el router de cliente este
  // modulo queda vivo toda la sesion: el estado por pagina se rearma en
  // `astro:page-load` y queda vacio al salir a una pagina sin indice. Las
  // suscripciones al scroll se cuelgan una sola vez, porque rehacerlas por
  // pagina las iria acumulando.
  const NAV_HEIGHT = 64;

  let linkBySlug = new Map<string, HTMLAnchorElement>();
  let headingEls: HTMLElement[] = [];
  let toc: HTMLElement | null = null;
  let title: HTMLElement | null = null;
  let activeSlug: string | null = null;
  let ticking = false;

  // El offset lo marca el titulo del post cuando quedo pegado y funciona
  // como barra; si no, el nav. Medir el header del post ya no sirve: es
  // estatico y se va del viewport.
  const topOffset = () =>
    title?.classList.contains("is-stuck")
      ? title.getBoundingClientRect().bottom
      : NAV_HEIGHT;

  // El espinazo crece hasta el centro del item activo, no segun el scroll de
  // la pagina: midiendo cosas distintas, la punta y el pip se separaban
  // hasta 50px y parecia que uno de los dos fallaba.
  const paintSpine = () => {
    const link = activeSlug ? linkBySlug.get(activeSlug) : null;
    const fill = link ? link.offsetTop + link.offsetHeight / 2 : 0;
    toc?.style.setProperty("--toc-fill", `${fill}px`);
  };

  const setActive = (slug: string | null) => {
    if (slug === activeSlug) return;
    if (activeSlug) linkBySlug.get(activeSlug)?.classList.remove("is-active");
    if (slug) linkBySlug.get(slug)?.classList.add("is-active");
    activeSlug = slug;
    paintSpine();
  };

  // Se calcula el heading activo directamente en vez de observar
  // intersecciones: con secciones largas ningun heading cae dentro de la
  // banda del observer y el indice se quedaba pegado al anterior durante
  // miles de pixeles.
  const update = () => {
    ticking = false;
    if (headingEls.length === 0) return;

    const offset = topOffset() + 24;

    let current: string | null = null;
    for (const el of headingEls) {
      if (el.getBoundingClientRect().top > offset) break;
      current = el.id;
    }

    // Al final de la pagina el ultimo heading sigue por debajo del umbral
    // (abajo no queda una pantalla entera de contenido), asi que la ultima
    // seccion no se marcaba nunca en ningun post.
    const fondo =
      window.scrollY + window.innerHeight >=
      document.documentElement.scrollHeight - 2;
    if (fondo) {
      current = headingEls[headingEls.length - 1].id;
    }

    setActive(current);
  };

  const request = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  window.addEventListener("scroll", request, { passive: true });
  window.addEventListener("resize", () => {
    // Al cambiar de ancho los items se reacomodan (los titulos largos pasan
    // de una linea a dos), asi que el relleno hay que recalcularlo.
    paintSpine();
    request();
  });

  // `astro:page-load` corre tambien en la carga inicial, asi que esta es la
  // unica inicializacion.
  document.addEventListener("astro:page-load", () => {
    const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");

    linkBySlug = new Map();
    links.forEach((link) => {
      const slug = link.dataset.slug;
      if (slug) linkBySlug.set(slug, link);
    });

    headingEls = Array.from(linkBySlug.keys())
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    toc = document.querySelector<HTMLElement>(".toc");
    title = document.querySelector<HTMLElement>(".post-title");
    activeSlug = null;

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const slug = link.dataset.slug;
        const target = slug ? document.getElementById(slug) : null;
        if (!target) return;

        event.preventDefault();

        // Se descuenta la chrome fija de arriba para que el heading destino
        // no quede tapado detrás de ella.
        const gap = 16;
        const top =
          target.getBoundingClientRect().top +
          window.scrollY -
          topOffset() -
          gap;

        window.scrollTo({ top, behavior: "smooth" });
        history.pushState(null, "", `#${slug}`);
      });
    });

    update();
  });
</script>
