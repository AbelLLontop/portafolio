---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{
  headings.length > 0 && (
    <nav class="toc" aria-label="Índice del post">
      {/* Sin -ml-3 (que anulaba el pl-3 del indice) el titulo deja de pegarse
          a la linea; el pl-0.5 lo cuadra con el borde de 2px de los items. */}
      <p class="section-label mb-3 pl-0.5">En este post</p>
      <ul class="space-y-0.5">
        {headings.map((heading) => (
          <li>
            <a href={`#${heading.slug}`} class="toc-link" data-depth={heading.depth} data-slug={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
  if (links.length > 0) {
    const linkBySlug = new Map<string, HTMLAnchorElement>();
    links.forEach((link) => {
      const slug = link.dataset.slug;
      if (slug) linkBySlug.set(slug, link);
    });

    const headingEls = Array.from(linkBySlug.keys())
      .map((slug) => document.getElementById(slug))
      .filter((el): el is HTMLElement => el !== null);

    const header = document.querySelector<HTMLElement>(".post-header");

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const slug = link.dataset.slug;
        const target = slug ? document.getElementById(slug) : null;
        if (!target) return;

        event.preventDefault();

        // Usamos la altura actual del header sticky (que cambia entre su
        // estado normal y el encogido) para que el heading destino no
        // quede tapado detrás de él.
        const headerBottom = header?.getBoundingClientRect().bottom ?? 0;
        const gap = 16;
        const top = target.getBoundingClientRect().top + window.scrollY - headerBottom - gap;

        window.scrollTo({ top, behavior: "smooth" });
        history.pushState(null, "", `#${slug}`);
      });
    });

    const toc = document.querySelector<HTMLElement>(".toc");

    let activeSlug: string | null = null;

    // El espinazo crece hasta el centro del item activo, no segun el scroll de
    // la pagina: midiendo cosas distintas, la punta y el pip se separaban
    // hasta 50px y parecia que uno de los dos fallaba.
    const paintSpine = () => {
      const link = activeSlug ? linkBySlug.get(activeSlug) : null;
      const fill = link ? link.offsetTop + link.offsetHeight / 2 : 0;
      toc?.style.setProperty("--toc-fill", `${fill}px`);
    };

    const setActive = (slug: string | null) => {
      if (slug === activeSlug) return;
      if (activeSlug) linkBySlug.get(activeSlug)?.classList.remove("is-active");
      if (slug) linkBySlug.get(slug)?.classList.add("is-active");
      activeSlug = slug;
      paintSpine();
    };

    // Se calcula el heading activo directamente en vez de observar
    // intersecciones: con secciones largas ningun heading cae dentro de la
    // banda del observer y el indice se quedaba pegado al anterior durante
    // miles de pixeles.
    let ticking = false;

    const update = () => {
      ticking = false;
      const offset = (header?.getBoundingClientRect().bottom ?? 0) + 24;

      let current: string | null = null;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top > offset) break;
        current = el.id;
      }

      // Al final de la pagina el ultimo heading sigue por debajo del umbral
      // (abajo no queda una pantalla entera de contenido), asi que la ultima
      // seccion no se marcaba nunca en ningun post.
      const fondo =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (fondo && headingEls.length > 0) {
        current = headingEls[headingEls.length - 1].id;
      }

      setActive(current);
    };

    const request = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", request, { passive: true });
    window.addEventListener("resize", () => {
      // Al cambiar de ancho los items se reacomodan (los titulos largos pasan
      // de una linea a dos), asi que el relleno hay que recalcularlo.
      paintSpine();
      request();
    });
  }
</script>
