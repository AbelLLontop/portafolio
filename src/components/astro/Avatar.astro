---
// Portada cuadrada de un artista del sello. Sin imagen propia se dibuja una
// con el nombre (la tipografía es el arte), así ningún elemento queda con un
// hueco gris.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata | null;
  alt: string;
  title: string;
  /** Lado en px de la imagen que se genera. */
  size: number;
  class?: string;
  /** Tamaño de letra de la portada dibujada. */
  fontSize?: string;
}

const { image, alt, title, size, class: className, fontSize } = Astro.props;
const [head, ...rest] = title.split(".");
---

<span class:list={["cov", className]}>
  {image ? (
    <Image src={image} alt={alt} width={size} height={size} />
  ) : (
    <span
      class="gencov"
      style={fontSize ? `font-size:${fontSize}` : undefined}
      aria-hidden="true"
    >
      {head}
      {rest.length > 0 && <b>.{rest.join(".")}</b>}
    </span>
  )}
</span>
