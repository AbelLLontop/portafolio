---
// Astro y no React a propósito: el markup es estático y solo un script corto
// muta `style.top` y `textContent`. Cero peso extra en el bundle de islas.
import { useTranslations, type Lang } from "../../i18n/index.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Umbral de scroll → nombre de la fase. Viaja al script como JSON en un
// data-*: un `<script>` de Astro se empaqueta aparte y no ve estas variables.
const phases: [number, string][] = [
  [0, t("hud.phase.platform")],
  [0.08, t("hud.phase.troposphere")],
  [0.26, t("hud.phase.stratosphere")],
  [0.46, t("hud.phase.mesosphere")],
  [0.64, t("hud.phase.karman")],
  [0.8, t("hud.phase.lowOrbit")],
  [0.93, t("hud.phase.deepSpace")],
];

// El reloj va en 24h en los dos idiomas (es la estética del HUD), pero el
// locale cambia los separadores.
const clockLocale = lang === "es" ? "es-PE" : "en-GB";
---

<div
  class="ascent-hud pointer-events-none fixed left-[18px] top-1/2 z-40 hidden -translate-y-1/2 flex-col items-start gap-3 xl:flex"
  aria-hidden="true"
>
  <div
    class="relative w-[2px] rounded-sm"
    style={`height: min(46vh, 340px); background: var(--line);`}
  >
    <i
      id="ascent-pip"
      class="absolute -left-1 block h-2.5 w-2.5 rounded-full"
      style="top: 0; background: var(--color-accent); box-shadow: 0 0 12px var(--color-accent); transition: top 0.12s linear;"
    ></i>
  </div>
  <div class="flex flex-col gap-1 font-mono uppercase">
    <span
      id="ascent-km"
      class="text-[1.05rem] tracking-[0.02em] text-zinc-100 [font-variant-numeric:tabular-nums]"
    >
      0.0 km
    </span>
    <span
      id="ascent-phase"
      class="max-w-[5.5rem] text-[0.6rem] leading-tight tracking-[0.14em] text-accent"
      data-phases={JSON.stringify(phases)}
    >
      {phases[0][1]}
    </span>
  </div>
</div>

<div
  class="pointer-events-none fixed right-[18px] top-[84px] z-40 hidden flex-col items-end gap-0.5 font-mono text-[0.6rem] uppercase leading-[1.9] tracking-[0.14em] xl:flex"
  style="color: var(--faint);"
  aria-hidden="true"
>
  <span>
    {t("hud.systems")}{" "}
    <b class="font-normal" style="color: var(--go);">
      {t("hud.nominal")}
    </b>
  </span>
  <span>
    {t("hud.link")}{" "}
    <b class="font-normal" style="color: var(--go);">
      {t("hud.stable")}
    </b>
  </span>
  <span id="ascent-clock" data-locale={clockLocale}>
    --:--:--
  </span>
</div>

<script>
  const MAX_ALTITUDE_KM = 408; // altitud orbital de la ISS

  // El HUD existe solo en los posts, pero con el router de cliente este módulo
  // queda vivo toda la sesión: sus referencias se rearman en cada página (en
  // `astro:page-load`) y quedan en null al salir a una página sin HUD, donde
  // todo esto no hace nada. Las suscripciones al scroll, en cambio, se cuelgan
  // una sola vez: rehacerlas por página las iría acumulando.
  let pip: HTMLElement | null = null;
  let kmLabel: HTMLElement | null = null;
  let phaseLabel: HTMLElement | null = null;
  let phases: [number, string][] = [];
  let clockTimer: ReturnType<typeof setInterval> | undefined;

  let ticking = false;

  // Único dueño del progreso de scroll del sitio: escribe `--ascent` en
  // documentElement y el resto (el veil) lo consume en CSS puro. Fuera de los
  // posts no escribe nada, así que ahí el veil se queda quieto.
  const update = () => {
    ticking = false;
    if (!pip || !kmLabel || !phaseLabel || phases.length === 0) return;

    const max = Math.max(
      1,
      document.documentElement.scrollHeight - window.innerHeight,
    );
    const progress = Math.min(1, Math.max(0, window.scrollY / max));

    document.documentElement.style.setProperty("--ascent", String(progress));

    pip.style.top = `calc(${progress * 100}% - 5px)`;
    kmLabel.textContent = `${(progress * MAX_ALTITUDE_KM).toFixed(1)} km`;

    let phase = phases[0][1];
    for (const [threshold, name] of phases) {
      if (progress >= threshold) phase = name;
    }
    phaseLabel.textContent = phase;
  };

  const request = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  window.addEventListener("scroll", request, { passive: true });
  window.addEventListener("resize", request);

  // `astro:page-load` corre también en la carga inicial, así que esta es la
  // única inicialización.
  document.addEventListener("astro:page-load", () => {
    pip = document.getElementById("ascent-pip");
    kmLabel = document.getElementById("ascent-km");
    phaseLabel = document.getElementById("ascent-phase");

    // Las fases llegan traducidas desde el .astro, por data-*.
    phases = JSON.parse(phaseLabel?.dataset.phases ?? "[]");

    update();

    clearInterval(clockTimer);
    const clock = document.getElementById("ascent-clock");
    if (clock) {
      const locale = clock.dataset.locale ?? "es-PE";
      const tick = () => {
        clock.textContent = new Date().toLocaleTimeString(locale, {
          hour12: false,
        });
      };
      tick();
      clockTimer = setInterval(tick, 1000);
    }
  });
</script>
